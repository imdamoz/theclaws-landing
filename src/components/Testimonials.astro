</div>

<style is:global>
  /* === DARK THEME — wrapper must not affect layout === */
  .testimonials-dark {
    display: contents;
  }

  /* === LIGHT THEME OVERRIDES === */
  .testimonials-light {
    background: none;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 60px;
  }
  .testimonials-light .home-testimonials_component {
    background: none !important;
  }
  .testimonials-light .home-testimonials_grid {
    background: none !important;
    -webkit-mask-image: none !important;
    mask-image: none !important;
  }
  .testimonials-light .home-testimonials_column {
    background: none !important;
    -webkit-mask-image: none !important;
    mask-image: none !important;
  }
  .testimonials-light .home-testimonials_component::before,
  .testimonials-light .home-testimonials_component::after {
    background: linear-gradient(to bottom, transparent 0%, #fff 100%) !important;
  }
  .testimonials-light .floater_wrapper {
    background-image: linear-gradient(transparent, #fff 80%) !important;
  }
  .testimonials-light .home-testimonials_card {
    background: #fff !important;
    border: 1px solid #eee !important;
    color: #1a1a1a !important;
  }
  .testimonials-light .home-testimonials_card .text-weight-medium {
    color: #1a1a1a !important;
  }
  .testimonials-light .home-testimonials_card .text-style-muted,
  .testimonials-light .home-testimonials_card p {
    color: #555 !important;
  }
  .testimonials-light .home-testimonials_card .text-size-small {
    color: #888 !important;
  }
  .testimonials-light .floater_component {
    background: #fff !important;
    border: 1px solid #eee !important;
    color: #1a1a1a !important;
  }
  .testimonials-light .floater_component .text-weight-medium {
    color: #1a1a1a !important;
  }

  /* === DARK THEME — wrapper must be invisible to layout === */
  .testimonials-dark {
    display: contents;
  }



</style>
