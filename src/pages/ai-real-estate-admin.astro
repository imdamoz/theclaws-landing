---
import Layout from '../layouts/Layout.astro';
import '../styles/ai-mortgage-admin/styles.css';
import '../styles/ai-mortgage-admin/sections.css';
import '../styles/ai-mortgage-admin/motion.css';
---

<Layout
  title="Max Real Estate Admin — More deals exchanged. Less time lost to admin."
  description="Connect the deal. Max Real Estate Admin reviews compliance, ID and source of funds, and drafts the buyer, vendor and solicitor chases for whatever is missing."
  ogTitle="Max Real Estate Admin — More deals exchanged. Less time lost to admin."
  ogDescription="Connect the deal. Max Real Estate Admin reviews compliance, ID and source of funds, and drafts the buyer, vendor and solicitor chases for whatever is missing."
  includeHomeStyles={false}
>

<style is:global>
  /* Per-page accent override — placeholder blue for Max. Final colour TBC. */
  :root {
    --lime: #4F8AF5;
    --lime-2: #3B6EE0;
    --lime-ink: #FFFFFF;
    --lime-rgb: 79, 138, 245;
  }

  /* ===== Hero v2 (4-card layout) — Max Real Estate Admin ===== */
  .hero-stage .agent {
    width: 84%;
    margin-top: 0;
  }
  .hero-stage .sbubble { display: none; }

  /* Card positioning — overrides original 3-card layout */
  .hero-stage .fcard-property,
  .hero-stage .fcard-chain,
  .hero-stage .fcard-compliance,
  .hero-stage .fcard-memo {
    position: absolute;
    background: var(--surface);
    border-radius: 11px;
    padding: 10px;
    box-shadow: 0 12px 26px -10px rgba(9,9,11,0.16), 0 1px 3px -1px rgba(9,9,11,0.05);
    border: 1px solid rgba(225, 227, 226, 0.6);
    font-family: var(--font-body);
  }
  .hero-stage .fcard-property   { top: 22px;   left: 0;     width: 192px; transform: rotate(-5deg); z-index: 4; }
  .hero-stage .fcard-chain      { top: 0;      right: 0;    width: 188px; z-index: 5; }
  .hero-stage .fcard-compliance { bottom: 70px; left: 8px;  width: 196px; transform: rotate(3deg);  z-index: 5; }
  .hero-stage .fcard-memo       { bottom: 50px; right: 0;   width: 192px; transform: rotate(-4deg); z-index: 4; }

  @media (max-width: 820px) {
    .hero-stage .fcard-property   { top: 30px;   left: 4px;   width: 175px; }
    .hero-stage .fcard-chain      { top: 4px;    right: 4px;  width: 175px; }
    .hero-stage .fcard-compliance { bottom: 50px; left: 4px;  width: 175px; }
    .hero-stage .fcard-memo       { bottom: 30px; right: 4px; width: 175px; }
  }

  /* ----- Shared card head ----- */
  .h2-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 9px;
  }
  .h2-head-left {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    flex: 1;
  }
  .h2-icon {
    width: 20px; height: 20px;
    border-radius: 5px;
    background: rgba(var(--lime-rgb), 0.12);
    color: var(--lime);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .h2-icon svg { width: 11px; height: 11px; }
  .h2-title-block { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
  .h2-title {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .h2-sub {
    font-size: 7.5px;
    color: var(--fg-3);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ----- Status pills (right side of head) ----- */
  .h2-tag {
    font-family: var(--font-mono);
    font-size: 7.5px;
    font-weight: 600;
    padding: 2px 5px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .h2-tag-live { background: #FDF2E9; color: #E67E22; }
  .h2-tag-live::before {
    content: '';
    width: 4px; height: 4px;
    border-radius: 50%;
    background: #E67E22;
    box-shadow: 0 0 0 1.5px rgba(230,126,34,0.25);
  }
  .h2-tag-issues { background: #FFDAD6; color: #93000A; }
  .h2-tag-issues svg { width: 8px; height: 8px; }
  .h2-tag-open { background: rgba(var(--lime-rgb), 0.12); color: var(--lime); }
  .h2-tag-progress {
    background: var(--surface-3);
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 500;
  }
  .h2-tag-progress::before {
    content: '';
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--lime);
  }

  /* ----- Property File card ----- */
  .h2-progress {
    height: 5px;
    background: var(--line);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 9px;
  }
  .h2-progress-fill {
    height: 100%;
    background: var(--lime);
    border-radius: 999px;
  }
  .h2-section-label {
    font-family: var(--font-mono);
    font-size: 7.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-3);
    margin-bottom: 7px;
  }
  .h2-doc-row {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    padding: 3px 0;
  }
  .h2-doc-row + .h2-doc-row { border-top: 1px solid var(--line); padding-top: 6px; margin-top: 3px; }
  .h2-doc-mark {
    width: 13px; height: 13px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 1px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .h2-doc-mark.done { background: rgba(var(--lime-rgb), 0.12); color: var(--lime); }
  .h2-doc-mark.pending { background: var(--surface-3); color: var(--fg-4); }
  .h2-doc-mark.empty { background: transparent; border: 1px solid var(--line-2); }
  .h2-doc-mark svg { width: 7px; height: 7px; }
  .h2-doc-text { display: flex; flex-direction: column; gap: 0; min-width: 0; }
  .h2-doc-name { font-size: 8.5px; font-weight: 500; color: var(--ink); line-height: 1.3; }
  .h2-doc-meta { font-size: 7px; color: var(--fg-3); line-height: 1.3; }
  .h2-doc-link { font-size: 7px; color: var(--lime); text-decoration: underline; cursor: pointer; }

  /* ----- Chain tracker rows ----- */
  .h2-list { display: flex; flex-direction: column; gap: 5px; }
  .h2-list-item {
    background: rgba(168,168,168,0.08);
    border-radius: 5px;
    padding: 6px 7px;
    display: flex;
    gap: 6px;
    align-items: flex-start;
  }
  .h2-list-icon {
    color: var(--lime);
    margin-top: 1px;
    flex-shrink: 0;
    display: inline-flex;
  }
  .h2-list-icon svg { width: 9px; height: 9px; }
  .h2-list-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .h2-list-title-row {
    display: flex;
    gap: 4px;
    align-items: center;
    font-size: 8px;
  }
  .h2-list-id { font-family: var(--font-display); font-weight: 700; color: var(--ink); }
  .h2-list-sep { color: var(--fg-3); }
  .h2-list-name { color: var(--ink); font-weight: 500; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .h2-list-meta-row {
    display: flex;
    gap: 6px;
    align-items: center;
    font-size: 7px;
    color: var(--fg-3);
  }
  .h2-prio {
    font-family: var(--font-mono);
    font-size: 6.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 1px 4px;
    border-radius: 2px;
    line-height: 1.4;
  }
  .h2-prio-high { background: #FFDAD6; color: #93000A; }
  .h2-prio-critical { background: #FDF2E9; color: #E67E22; }
  .h2-prio-low { background: #E7E8E7; color: #3F4944; }
  .h2-prio-normal { background: #8BD6B6; color: #FFFFFF; border-radius: 999px; padding: 1px 6px; }

  /* ----- Compliance / Memo rows ----- */
  .h2-comp-list { display: flex; flex-direction: column; gap: 4px; }
  .h2-comp-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 4px 2px;
  }
  .h2-comp-row + .h2-comp-row { border-top: 1px solid var(--line); padding-top: 6px; }
  .h2-comp-left { display: flex; align-items: center; gap: 7px; min-width: 0; flex: 1; }
  .h2-comp-ic {
    width: 19px; height: 19px;
    border-radius: 50%;
    background: rgba(var(--lime-rgb), 0.12);
    color: var(--lime);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .h2-comp-ic.danger { background: rgba(186,26,26,0.10); color: #BA1A1A; }
  .h2-comp-ic svg { width: 9px; height: 9px; }
  .h2-comp-text { min-width: 0; display: flex; flex-direction: column; gap: 0; flex: 1; }
  .h2-comp-name { font-size: 8.5px; font-weight: 600; color: var(--ink); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .h2-comp-meta { font-size: 7px; color: var(--fg-3); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .h2-status {
    font-family: var(--font-body);
    font-size: 7.5px;
    font-weight: 500;
    padding: 2px 6px;
    border-radius: 999px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    white-space: nowrap;
  }
  .h2-status svg { width: 7px; height: 7px; }
  .h2-status-ok { background: rgba(var(--lime-rgb), 0.12); color: var(--lime); }
  .h2-status-warn { background: rgba(186,26,26,0.10); color: #BA1A1A; }
  .h2-status-review { background: rgba(var(--lime-rgb), 0.12); color: var(--lime); }
  .h2-status-pending { background: #E7E8E7; color: #3F4944; }
  .h2-status-returned { background: rgba(254,243,199,0.7); color: #92400E; }
  .h2-status-missing { background: rgba(255,237,213,0.9); color: #EA580C; }
  .h2-status-approved { background: rgba(var(--lime-rgb), 0.12); color: var(--lime); }
  .h2-memo-row { position: relative; padding: 6px 7px; background: rgba(168,168,168,0.08); border-radius: 6px; }
  .h2-memo-row + .h2-memo-row { margin-top: 4px; }
  .h2-memo-row.alert { box-shadow: inset 3px 0 0 #EA580C; }

  /* ----- CTA button at bottom ----- */
  .h2-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 100%;
    background: var(--lime);
    color: var(--lime-ink);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 999px;
    margin-top: 9px;
    border: none;
    cursor: pointer;
  }
  .h2-cta svg { width: 9px; height: 9px; }
</style>

<div class="scroll-progress"></div>
<a class="float-cta" href="#book"><span class="dot"></span>Book a call<span class="arrow">→</span></a>

<!-- NAV -->
<header class="wrap">
  <nav class="nav">
    <a class="nav-brand" href="#">
      <img src="/images/the-claws-logo.svg" alt="TheClaws" class="nav-brand-logo" />
      <span>Max Real Estate Admin</span>
    </a>
    <div class="nav-links">
      <a href="#problem">Problem</a>
      <a href="#how">How it works</a>
      <a href="#case">Case study</a>
      <a href="#incl">Included</a>
      <a href="#faq">FAQ</a>
    </div>
    <a class="btn btn-sm btn-primary" href="#book">Book a call <span class="arrow">→</span></a>
  </nav>
</header>

<!-- ============ HERO (all above fold) ============ -->
<section class="hero wrap">
  <div class="hero-left">
    <div class="eyebrow reveal"><span class="dot"></span>Compliance &amp; ID reviewed in minutes, not hours</div>
    <h1 class="reveal reveal-delay-1">More deals exchanged.<br><span class="mark">Less time lost to admin.</span></h1>
    <p class="sub reveal reveal-delay-2">Connect the deal. Max Real Estate Admin reviews compliance, ID and source of funds, and drafts the buyer, vendor and solicitor chases for whatever is missing.</p>
    <div class="btns reveal reveal-delay-3">
      <a class="btn btn-lime btn-magnet" href="#book">Book a call &amp; see it on your deal <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="#how">See how it works</a>
    </div>
    <p class="micro reveal reveal-delay-4">We'll review one live deal on the call and show the gaps it would flag — bring the file, no prep needed.</p>

    <hr class="hero-divider reveal reveal-delay-4">

    <div class="hero-caps reveal reveal-delay-5">
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="16" y2="17"></line></svg>
        </span>
        <strong>Reads the whole deal</strong>
        <span>AML, ID, source of funds, chain notes, solicitor updates.</span>
      </div>
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        </span>
        <strong>Drafts the chase</strong>
        <span>Buyer, vendor, solicitor. You review before sending.</span>
      </div>
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </span>
        <strong>Fits your agency's rules</strong>
        <span>Your AML pack, your network, your tone.</span>
      </div>
    </div>
  </div>

  <div class="hero-stage">
    <img class="agent" src="/images/max-agent-ai-real-estate-admin.png" alt="Max Real Estate Admin reviewing a deal file">

    <!-- Property File card -->
    <div class="fcard-property">
      <div class="h2-head">
        <div class="h2-head-left">
          <span class="h2-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </span>
          <div class="h2-title-block">
            <span class="h2-title">Property File</span>
            <span class="h2-sub">124 Maplewood Drive</span>
          </div>
        </div>
        <span class="h2-tag h2-tag-progress">78% Complete</span>
      </div>
      <div class="h2-progress"><div class="h2-progress-fill" style="width: 78%;"></div></div>
      <div class="h2-section-label">Required documents</div>

      <div class="h2-doc-row">
        <span class="h2-doc-mark done">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <div class="h2-doc-text">
          <span class="h2-doc-name">Sales memo uploaded</span>
          <span class="h2-doc-meta">Verified on Oct 24</span>
        </div>
      </div>
      <div class="h2-doc-row">
        <span class="h2-doc-mark done">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <div class="h2-doc-text">
          <span class="h2-doc-name">Proof of ID received</span>
          <span class="h2-doc-meta">Verified on Oct 25</span>
        </div>
      </div>
      <div class="h2-doc-row">
        <span class="h2-doc-mark pending">
          <svg width="10" height="3" viewBox="0 0 12 3" fill="currentColor" aria-hidden="true"><circle cx="2" cy="1.5" r="1"/><circle cx="6" cy="1.5" r="1"/><circle cx="10" cy="1.5" r="1"/></svg>
        </span>
        <div class="h2-doc-text">
          <span class="h2-doc-name">Mortgage offer pending</span>
          <span class="h2-doc-meta">Awaiting lender confirmation</span>
        </div>
      </div>
      <div class="h2-doc-row">
        <span class="h2-doc-mark empty"></span>
        <div class="h2-doc-text">
          <span class="h2-doc-name">Chain notes incomplete</span>
          <a class="h2-doc-link" href="#">Update Notes</a>
        </div>
      </div>

      <button class="h2-cta">Review File <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
    </div>

    <!-- Chain Tracker card -->
    <div class="fcard-chain">
      <div class="h2-head">
        <div class="h2-head-left">
          <span class="h2-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </span>
          <div class="h2-title-block">
            <span class="h2-title">Chain Tracker</span>
            <span class="h2-sub">Deal: 124 Maplewood Drive</span>
          </div>
        </div>
        <span class="h2-tag h2-tag-live">Live</span>
      </div>

      <div class="h2-list">
        <div class="h2-list-item">
          <span class="h2-list-icon">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </span>
          <div class="h2-list-body">
            <div class="h2-list-title-row">
              <span class="h2-list-id">CHN-014</span>
              <span class="h2-list-sep">·</span>
              <span class="h2-list-name">Buyer's solicitor reply</span>
            </div>
            <div class="h2-list-meta-row">
              <span>Due in 2 days</span>
              <span class="h2-prio h2-prio-high">High priority</span>
            </div>
          </div>
        </div>

        <div class="h2-list-item">
          <span class="h2-list-icon">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </span>
          <div class="h2-list-body">
            <div class="h2-list-title-row">
              <span class="h2-list-id">CHN-017</span>
              <span class="h2-list-sep">·</span>
              <span class="h2-list-name">Lender confirmation</span>
            </div>
            <div class="h2-list-meta-row">
              <span>Overdue</span>
              <span class="h2-prio h2-prio-critical">Critical</span>
            </div>
          </div>
        </div>

        <div class="h2-list-item">
          <span class="h2-list-icon">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <div class="h2-list-body">
            <div class="h2-list-title-row">
              <span class="h2-list-id">CHN-021</span>
              <span class="h2-list-sep">·</span>
              <span class="h2-list-name">Searches returned</span>
            </div>
            <div class="h2-list-meta-row">
              <span>Resolved</span>
              <span class="h2-prio h2-prio-low">Low</span>
            </div>
          </div>
        </div>

        <div class="h2-list-item">
          <span class="h2-list-icon">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <div class="h2-list-body">
            <div class="h2-list-title-row">
              <span class="h2-list-id">CHN-024</span>
              <span class="h2-list-sep">·</span>
              <span class="h2-list-name">Vendor reply due</span>
            </div>
            <div class="h2-list-meta-row">
              <span>Due today</span>
              <span class="h2-prio h2-prio-normal">Normal</span>
            </div>
          </div>
        </div>
      </div>

