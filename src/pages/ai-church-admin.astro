---
import Layout from '../layouts/Layout.astro';
import '../styles/ai-mortgage-admin/styles.css';
import '../styles/ai-mortgage-admin/sections.css';
import '../styles/ai-mortgage-admin/motion.css';
---

<Layout
  title="Zara Church Admin — More time on ministry. Less time lost to admin."
  description="Connect the inbox. Zara Church Admin reviews member queries, giving and event sign-ups, and drafts the pastoral, volunteer and donor responses for whatever is missing."
  ogTitle="Zara Church Admin — More time on ministry. Less time lost to admin."
  ogDescription="Connect the inbox. Zara Church Admin reviews member queries, giving and event sign-ups, and drafts the pastoral, volunteer and donor responses for whatever is missing."
  includeHomeStyles={false}
>

<style is:global>
  /* Zara accent — amber. */
  :root {
    --lime: #F59E0B;
    --lime-2: #D97706;
    --lime-ink: #1F1500;
    --lime-rgb: 245, 158, 11;
  }

  /* ===== Hero v2 (4-card layout) — Zara Church Admin ===== */
  .hero-stage .agent { width: 86%; margin-top: 0; }
  .hero-stage .sbubble { display: none; }

  .hero-stage .fcard-checklist,
  .hero-stage .fcard-reply,
  .hero-stage .fcard-timeline,
  .hero-stage .fcard-chase {
    position: absolute;
    background: var(--surface);
    border-radius: 11px;
    padding: 11px;
    box-shadow: 0 12px 26px -10px rgba(9,9,11,0.16), 0 1px 3px -1px rgba(9,9,11,0.05);
    border: 1px solid rgba(225, 227, 226, 0.6);
    font-family: var(--font-body);
  }
  .hero-stage .fcard-checklist { top: 8px;     left: 0;    width: 218px; transform: rotate(3deg);  z-index: 5; }
  .hero-stage .fcard-reply     { top: 40px;    right: 0;   width: 192px; z-index: 4; }
  .hero-stage .fcard-timeline  { bottom: 50px; left: 16px; width: 200px; transform: rotate(-1deg); z-index: 4; }
  .hero-stage .fcard-chase     { bottom: 30px; right: 0;   width: 198px; transform: rotate(-3deg); z-index: 5; }

  @media (max-width: 820px) {
    .hero-stage .fcard-checklist { top: 12px;    left: 4px;  width: 190px; }
    .hero-stage .fcard-reply     { top: 30px;    right: 4px; width: 175px; }
    .hero-stage .fcard-timeline  { bottom: 40px; left: 4px;  width: 180px; }
    .hero-stage .fcard-chase     { bottom: 20px; right: 4px; width: 180px; }
  }

  /* ----- Shared header ----- */
  .chc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 9px;
  }
  .chc-head-left { display: flex; align-items: center; gap: 6px; min-width: 0; flex: 1; }
  .chc-icon {
    width: 22px; height: 22px;
    border-radius: 6px;
    background: var(--surface-3);
    color: var(--lime);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .chc-icon svg { width: 12px; height: 12px; }
  .chc-title-block { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
  .chc-title {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .chc-sub {
    font-size: 7.5px;
    color: var(--fg-3);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ----- Status pills ----- */
  .chc-tag {
    font-family: var(--font-body);
    font-size: 8px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .chc-tag-progress { background: rgba(var(--lime-rgb), 0.15); color: var(--lime-2); }
  .chc-tag-ready {
    background: rgba(var(--lime-rgb), 0.15);
    color: var(--lime-2);
  }
  .chc-tag-ready::before {
    content: '';
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--lime);
  }
  .chc-tag-live {
    background: rgba(var(--lime-rgb), 0.10);
    color: var(--lime-2);
  }
  .chc-tag-live::before {
    content: '';
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--lime);
  }
  .chc-tag-draft {
    background: #FFEDD5;
    color: #EA580C;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 7.5px;
  }

  /* ----- Sunday Checklist ----- */
  .chc-progress-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 8px;
    margin-bottom: 4px;
  }
  .chc-progress-row .lbl { color: var(--fg-3); }
  .chc-progress-row .pct { color: var(--ink); font-weight: 500; }
  .chc-progress {
    height: 8px;
    background: var(--line);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 9px;
  }
  .chc-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--lime-2) 0%, var(--lime) 100%);
    border-radius: 999px;
  }
  .chc-list { display: flex; flex-direction: column; gap: 5px; margin-bottom: 9px; }
  .chc-list-item {
    background: var(--surface-3);
    border-radius: 7px;
    padding: 7px;
    display: flex;
    gap: 7px;
    align-items: flex-start;
  }
  .chc-list-item.outline {
    background: var(--surface);
    border: 1px solid rgba(190, 201, 194, 0.30);
    box-shadow: inset 3px 0 0 var(--lime);
    padding-left: 9px;
  }
  .chc-list-item.outline.danger { box-shadow: inset 3px 0 0 #BA1A1A; }
  .chc-list-mark {
    width: 13px; height: 13px;
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--lime);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .chc-list-mark svg { width: 11px; height: 11px; }
  .chc-list-mark-empty {
    width: 11px; height: 11px;
    border-radius: 50%;
    border: 1px solid #BEC9C2;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .chc-list-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .chc-list-name { font-size: 9px; font-weight: 500; color: var(--ink); line-height: 1.3; }
  .chc-list-name.done { text-decoration: line-through; opacity: 0.7; }
  .chc-list-meta { font-size: 7.5px; color: var(--fg-3); line-height: 1.3; }
  .chc-list-meta.danger { color: #BA1A1A; }
  .chc-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 100%;
    background: var(--lime);
    color: var(--lime-ink);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
  }
  .chc-cta svg { width: 9px; height: 9px; }

  /* ----- Pastoral Reply Draft (top-right) ----- */
  .chc-msg-preview {
    background: var(--surface-3);
    border: 1px solid rgba(190, 201, 194, 0.20);
    border-radius: 7px;
    padding: 8px;
    margin-bottom: 7px;
  }
  .chc-msg-preview-label {
    font-family: var(--font-display);
    font-size: 7.5px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 3px;
  }
  .chc-msg-preview-body {
    font-size: 7.5px;
    color: var(--fg-3);
    line-height: 1.5;
  }
  .chc-meta-rows { display: flex; flex-direction: column; gap: 4px; margin-bottom: 9px; }
  .chc-meta-row {
    background: var(--surface-2);
    border: 1px solid rgba(190, 201, 194, 0.10);
    border-radius: 6px;
    padding: 6px 7px;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .chc-meta-label {
    font-size: 7px;
    font-weight: 500;
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }
  .chc-meta-value {
    font-size: 8.5px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }
  .chc-foot {
    margin: -2px -11px -11px;
    padding: 8px 11px;
    background: var(--surface-3);
    border-top: 1px solid rgba(190, 201, 194, 0.20);
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
  }
  .chc-btn-text {
    color: var(--lime);
    font-size: 8px;
    font-weight: 500;
    background: none;
    border: none;
    padding: 5px 8px;
    cursor: pointer;
  }
  .chc-btn-primary {
    background: var(--lime);
    color: var(--lime-ink);
    border: none;
    border-radius: 999px;
    padding: 5px 10px;
    font-size: 8px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    cursor: pointer;
    white-space: nowrap;
  }
  .chc-btn-primary svg { width: 8px; height: 8px; }

  /* ----- Service Timeline ----- */
  .chc-timeline { position: relative; padding-left: 0; }
  .chc-timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--line);
  }
  .chc-timeline-item {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    margin-bottom: 9px;
    position: relative;
  }
  .chc-timeline-item:last-child { margin-bottom: 0; }
  .chc-timeline-dot {
    width: 15px; height: 15px;
    border-radius: 50%;
    background: var(--lime);
    color: white;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 2px var(--surface);
    z-index: 1;
  }
  .chc-timeline-dot svg { width: 8px; height: 8px; }
  .chc-timeline-dot.muted { background: #EDEEED; color: var(--fg-3); }
  .chc-timeline-body { flex: 1; min-width: 0; padding-top: 1px; }
  .chc-timeline-row1 { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; }
  .chc-timeline-name { font-size: 9px; font-weight: 600; color: var(--ink); line-height: 1.2; }
  .chc-timeline-name.muted { color: var(--fg-3); }
  .chc-timeline-status { font-size: 7px; font-weight: 500; color: var(--lime); line-height: 1.2; flex-shrink: 0; }
  .chc-timeline-status.muted { color: var(--fg-4); }
  .chc-timeline-meta { font-size: 7.5px; color: var(--fg-3); margin-top: 2px; line-height: 1.3; }
  .chc-timeline-bar {
    margin-top: 4px;
    height: 3px;
    background: var(--line);
    border-radius: 999px;
    overflow: hidden;
  }
  .chc-timeline-bar-fill {
    height: 100%;
    background: var(--lime);
    border-radius: 999px;
  }

  /* ----- Volunteer Chase ----- */
  .chc-meta-box {
    background: var(--surface-3);
    border-radius: 7px;
    padding: 7px;
    margin-bottom: 6px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .chc-meta-box .chc-meta-row { background: transparent; border: 0; padding: 0; }
  .chc-priority-dot {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .chc-priority-dot::before {
    content: '';
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #BA1A1A;
  }
  .chc-msg-block {
    background: rgba(225, 227, 226, 0.30);
    border: 1px solid rgba(190, 201, 194, 0.30);
    border-radius: 7px;
    padding: 7px;
    margin-bottom: 9px;
  }
  .chc-msg-block-label {
    font-size: 7px;
    font-weight: 600;
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 3px;
  }
  .chc-msg-block-body {
    font-size: 7.5px;
    color: var(--ink);
    line-height: 1.5;
  }
  .chc-btn-row { display: flex; gap: 5px; }
  .chc-btn-row > * { flex: 1; }
  .chc-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    background: var(--surface-3);
    color: var(--lime-2);
    border: none;
    border-radius: 9px;
    padding: 5px 8px;
    font-size: 8.5px;
    font-weight: 600;
    cursor: pointer;
  }
  .chc-btn-ghost svg { width: 9px; height: 9px; }
  .chc-btn-solid {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    background: var(--lime);
    color: var(--lime-ink);
    border: none;
    border-radius: 9px;
    padding: 5px 8px;
    font-size: 8.5px;
    font-weight: 600;
    cursor: pointer;
  }
  .chc-btn-solid svg { width: 9px; height: 9px; }
</style>

<div class="scroll-progress"></div>
<a class="float-cta" href="#book"><span class="dot"></span>Book a call<span class="arrow">→</span></a>

<!-- NAV -->
<header class="wrap">
  <nav class="nav">
    <a class="nav-brand" href="#">
      <img src="/images/the-claws-logo.svg" alt="TheClaws" class="nav-brand-logo" />
      <span>Zara Church Admin</span>
    </a>
    <div class="nav-links">
      <a href="#problem">Problem</a>
      <a href="#how">How it works</a>
      <a href="#case">Case study</a>
      <a href="#incl">Included</a>
      <a href="#faq">FAQ</a>
    </div>
    <a class="btn btn-sm btn-primary" href="#book">Book a call <span class="arrow">→</span></a>
  </nav>
</header>

<!-- ============ HERO (all above fold) ============ -->
<section class="hero wrap">
  <div class="hero-left">
    <div class="eyebrow reveal"><span class="dot"></span>Inbox reviewed in minutes, not hours</div>
    <h1 class="reveal reveal-delay-1">More time on ministry.<br><span class="mark">Less time lost to admin.</span></h1>
    <p class="sub reveal reveal-delay-2">Connect the inbox. Zara Church Admin reviews member queries, giving and event sign-ups, and drafts the pastoral, volunteer and donor responses for whatever is missing.</p>
    <div class="btns reveal reveal-delay-3">
      <a class="btn btn-lime btn-magnet" href="#book">Book a call &amp; see it on your inbox <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="#how">See how it works</a>
    </div>
    <p class="micro reveal reveal-delay-4">We'll review one live week of inbox on the call and show the gaps it would flag — bring the messages, no prep needed.</p>

    <hr class="hero-divider reveal reveal-delay-4">

    <div class="hero-caps reveal reveal-delay-5">
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="16" y2="17"></line></svg>
        </span>
        <strong>Reads every message</strong>
        <span>Pastoral queries, giving, sign-ups, safeguarding, school admin.</span>
      </div>
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        </span>
        <strong>Drafts the response</strong>
        <span>Member, family, volunteer, donor. You review before sending.</span>
      </div>
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </span>
        <strong>Fits your church's tone</strong>
        <span>Your safeguarding policy, your welcome process, your voice.</span>
      </div>
    </div>
  </div>

  <div class="hero-stage">
    <img class="agent" src="/images/zara-agent-ai-church-admin.png" alt="Zara Church Admin reviewing the parish inbox">

    <!-- Sunday Checklist card -->
    <div class="fcard-checklist">
      <div class="chc-head">
        <div class="chc-title-block">
          <span class="chc-title">Sunday Checklist</span>
          <div style="display: flex; align-items: center; gap: 6px; margin-top: 3px;">
            <span class="chc-tag chc-tag-progress">82% Complete</span>
            <span style="font-size: 7.5px; color: var(--fg-3);">This week</span>
          </div>
        </div>
        <span class="chc-icon" style="width: 26px; height: 26px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
        </span>
      </div>

      <div class="chc-progress-row">
        <span class="lbl">Progress</span>
        <span class="pct">82%</span>
      </div>
      <div class="chc-progress"><div class="chc-progress-fill" style="width: 82%;"></div></div>

      <div class="chc-list">
        <div class="chc-list-item">
          <span class="chc-list-mark">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          </span>
          <div class="chc-list-text">
            <span class="chc-list-name done">Sermon notes published</span>
            <span class="chc-list-meta">Completed by Sarah on Oct 12</span>
          </div>
        </div>

        <div class="chc-list-item outline">
          <span class="chc-list-mark-empty"></span>
          <div class="chc-list-text">
            <span class="chc-list-name">Volunteer rota confirmed</span>
            <span class="chc-list-meta">Due today</span>
          </div>
        </div>

        <div class="chc-list-item outline danger">
          <span class="chc-list-mark-empty"></span>
          <div class="chc-list-text">
            <span class="chc-list-name">Safeguarding records review</span>
            <span class="chc-list-meta danger">3 items remaining</span>
          </div>
        </div>
      </div>

      <button class="chc-cta">Request Review <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
    </div>

    <!-- Pastoral Reply Draft card -->
    <div class="fcard-reply">
      <div class="chc-head">
        <div class="chc-head-left">
          <span class="chc-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </span>
          <div class="chc-title-block">
            <span class="chc-title">Pastoral Reply</span>
            <span class="chc-sub">Automated follow-up</span>
          </div>
        </div>
        <span class="chc-tag chc-tag-ready">Ready to Send</span>
      </div>

      <div class="chc-msg-preview">
        <div class="chc-msg-preview-label">Message Preview</div>
        <div class="chc-msg-preview-body">"Hi Sarah, just checking in following our chat last week. The pastoral team would love to schedule a coffee — let me know what works for you this week."</div>
      </div>

      <div class="chc-meta-rows">
        <div class="chc-meta-row">
          <span class="chc-meta-label">To</span>
          <span class="chc-meta-value">Sarah Whitman</span>
        </div>
        <div class="chc-meta-row">
          <span class="chc-meta-label">Related concern</span>
          <span class="chc-meta-value">Bereavement support</span>
        </div>
        <div class="chc-meta-row">
          <span class="chc-meta-label">Priority</span>
          <span class="chc-meta-value">Medium</span>
        </div>
      </div>

      <div class="chc-foot">
        <button class="chc-btn-text">Edit Draft</button>
        <button class="chc-btn-primary">
          Review &amp; Send
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </div>
    </div>

    <!-- Service Timeline card -->
    <div class="fcard-timeline">
      <div class="chc-head">
        <div class="chc-title-block">
          <span class="chc-title">Service Timeline</span>
        </div>
        <span class="chc-tag chc-tag-live">Live</span>
      </div>

      <div class="chc-timeline">
        <div class="chc-timeline-item">
          <span class="chc-timeline-dot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <div class="chc-timeline-body">
            <div class="chc-timeline-row1">
