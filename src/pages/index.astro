<script is:inline>
function submitToLoops(){
  var email=document.getElementById('loopsEmail').value.trim();
  var btn=document.getElementById('loopsBtn');
  var msg=document.getElementById('loopsMsg');
  if(!email||email.indexOf('@')===-1){
    msg.style.display='block';
    msg.style.color='#ef4444';
    msg.textContent='Please enter a valid email.';
    return;
  }
  btn.disabled=true;
  btn.textContent='Sending...';
  btn.style.opacity='0.6';
  msg.style.display='none';
  fetch('https://app.loops.so/api/newsletter-form/cmd5dsm0e055sut0jqsc3jq90',{
    method:'POST',
    headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body:'email='+encodeURIComponent(email)+'&mailingLists='+encodeURIComponent('{"cmn4itjwm6x1i0i0c7bkr92q1":true}')
  }).then(function(r){return r.json()}).then(function(data){
    btn.disabled=false;
    btn.style.opacity='1';
    if(data.success||data.id||data.message==='Email is already on the list.'){
      btn.textContent='Welcome!';
      btn.style.background='#22c55e';
      msg.style.display='block';
      msg.style.color='#22c55e';
      msg.textContent='You are on the list!';
      document.getElementById('loopsEmail').value='';
      setTimeout(function(){
        btn.textContent='Activate';
        btn.style.background='#000';
        msg.style.display='none';
      },4000);
    }else{
      btn.textContent='Activate';
      msg.style.display='block';
      msg.style.color='#ef4444';
      msg.textContent=data.message||'Something went wrong. Try again.';
    }
  }).catch(function(){
    btn.disabled=false;
    btn.style.opacity='1';
    btn.textContent='Activate';
    msg.style.display='block';
    msg.style.color='#ef4444';
    msg.textContent='Something went wrong. Try again.';
  });
}
</script>
