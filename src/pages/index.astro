</section>
<div class="SuperAgentsV2_wrapper__qfQjf" style="--background:#ffffff;--surface:#f0f0f0;--surface-inverse:#dedede;--border:#e4e4e7;--text:#09090b;--text-inverse:#ffffff;--text-medium:#71717a;--text-soft:#a1a1aa;--primary:#09090b;--primary-hover:#27272a;--secondary:#aaa;--secondary-hover:#999;--white:#ffffff;--black:#09090b;--max-width:1280px;--padding:0 60px;--m-padding:0 20px;--section-padding:clamp(48px, 8vw, 120px);--radius-sm:8px;--radius:12px;--radius-lg:16px;--radius-xl:24px;--radius-full:100px;--shadow-sm:0px 1px 2px rgba(0, 0, 0, 0.05);--shadow:0px 10px 30px -5px rgba(0, 0, 0, 0.1);--shadow-lg:0px 20px 40px -5px rgba(0, 0, 0, 0.15);--backdrop-blur:blur(8px);--transition:all 0.2s ease;--transition-slow:all 0.3s ease"><main>
<section class="section_workforce-carousel" id="solutions-section"><img src="/assets/tree-root.png" class="tree-root-img" aria-hidden="true" />
  <div class="wf-pad">
    <div class="wf-center">
      <div class="wf-center-inner">
        <h2 class="wf-h2">Cut the noise and fix the root problems.</h2>
        <p class="wf-p">Role-based AI agents handle coordination, client updates, task follow-ups, and invoice chasing across your existing tools so you scale without hiring.</p>
        <div class="wf-btn-wrap"><a href="https://calendly.com/osama-bereceptive/new-meeting" target="_blank" class="wf-btn">Book a Demo</a></div>
      </div>
    </div>
    <div class="wf-slider" data-wf-slider>
      <div class="wf-track" data-wf-track>
        <div class="wf-slide">
          <div class="wf-img-wrap"><img src="/assets/Rectangle 2.png" alt="Slow lead response" class="wf-img" loading="lazy" /></div>
          <h3 class="wf-h5">Slow lead response</h3>
          <p class="wf-text">Reply fast and follow up until booked or closed.</p>
        </div>
        <div class="wf-slide">
          <div class="wf-img-wrap"><img src="/assets/Rectangle 3.png" alt="Proposal limbo" class="wf-img" loading="lazy" /></div>
          <h3 class="wf-h5">Proposal limbo</h3>
          <p class="wf-text">Chase quotes and proposals so deals do not stall.</p>
        </div>
        <div class="wf-slide">
          <div class="wf-img-wrap"><img src="/assets/Rectangle 10.png" alt="Client onboarding drag" class="wf-img" loading="lazy" /></div>
          <h3 class="wf-h5">Client onboarding drag</h3>
          <p class="wf-text">Collect info and documents without endless back and forth.</p>
        </div>
        <div class="wf-slide">
          <div class="wf-img-wrap"><img src="/assets/Rectangle 11.png" alt="Stalled work" class="wf-img" loading="lazy" /></div>
          <h3 class="wf-h5">Stalled work</h3>
          <p class="wf-text">Chase tasks, approvals, and updates so delivery keeps moving.</p>
        </div>
        <div class="wf-slide">
          <div class="wf-img-wrap"><img src="/assets/Frame 1.png" alt="Late payments" class="wf-img" loading="lazy" /></div>
          <h3 class="wf-h5">Late payments</h3>
          <p class="wf-text">Send payment nudges and follow up until paid.</p>
        </div>
      </div>
    </div>
    <div class="wf-dots" data-wf-dots></div>
  </div>
</section>
<section class="agent-cards-section">
  <div class="agent-cards-row">
    <div class="agent-card">
      <img src="/assets/onboarding.png" alt="Guided onboarding" class="agent-card-img" loading="lazy" />
      <div class="agent-card-text">
        <h4 class="agent-card-title">Guided onboarding, built for speed</h4>
        <p class="agent-card-desc">Pick the roles you need, connect your tools, and set the rules in the dashboard. If you want help, we guide you end‑to‑end so you can launch in minutes.</p>
      </div>
    </div>
    <div class="agent-card">
      <img src="/assets/support.png" alt="Real support" class="agent-card-img" loading="lazy" />
      <div class="agent-card-text">
        <h4 class="agent-card-title">Real support, not a ticket black hole</h4>
        <p class="agent-card-desc">Get help when you need it, fast. We guide setup, answer questions, and help you fine‑tune your agents so they keep delivering results as your workflow evolves.</p>
      </div>
    </div>
  </div>
</section>
<script is:inline>
(function(){
  var s=document.createElement('style');
  s.textContent='@keyframes intScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}';
  document.head.appendChild(s);
  function startMarquee(){
    var tracks=document.querySelectorAll('.integrations-marquee .marquee-track');
    if(!tracks.length){setTimeout(startMarquee,300);return}
    tracks.forEach(function(t){
      var isRtl=t.closest('.marquee-rtl');
      t.style.animation='intScroll 12s linear infinite'+(isRtl?' reverse':'');
    });
  }
  startMarquee();
})();
</script>

