<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // === WORKFORCE SLIDER ===
  (function() {
    var slider = document.querySelector('[data-wf-slider]');
    var track = document.querySelector('[data-wf-track]');
    var dotsWrap = document.querySelector('[data-wf-dots]');
    if (!slider || !track || !dotsWrap) return;

    var slides = track.querySelectorAll('.wf-slide');
    var currentIdx = 0;
    var perView = 3;

    function getPerView() {
      var w = window.innerWidth;
      if (w <= 767) return 1;
      if (w <= 991) return 2;
      return 3;
    }

    function getMaxIdx() {
      return slides.length - 1;
    }

    function buildDots() {
      dotsWrap.innerHTML = '';
      var count = slides.length;
      for (var i = 0; i < count; i++) {
        var dot = document.createElement('button');
        dot.className = 'wf-dot' + (i === currentIdx ? ' active' : '');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        dot.addEventListener('click', (function(idx) {
          return function() { goTo(idx); };
        })(i));
        dotsWrap.appendChild(dot);
      }
    }

    function goTo(idx) {
      currentIdx = Math.max(0, Math.min(idx, getMaxIdx()));
      var slideW = slides[0].offsetWidth;
      var gap = parseFloat(getComputedStyle(track).gap) || 32;
      var containerW = slider.offsetWidth;
      var centerOffset = (containerW - slideW) / 2;
      track.style.transform = 'translateX(' + (centerOffset - (slideW + gap) * currentIdx) + 'px)';
      // Update active slide
      slides.forEach(function(s, i) {
        s.classList.toggle('wf-active', i === currentIdx);
      });
      // Update dots
      dotsWrap.querySelectorAll('.wf-dot').forEach(function(d, i) {
        d.classList.toggle('active', i === currentIdx);
      });
    }

    // Drag support
    var isDragging = false, dragStartX = 0, dragStartTranslate = 0;
    slider.addEventListener('mousedown', function(e) {
      isDragging = true;
      dragStartX = e.clientX;
      var m = track.style.transform.match(/translateX\((.+)px\)/);
      dragStartTranslate = m ? parseFloat(m[1]) : 0;
      track.style.transition = 'none';
      slider.style.cursor = 'grabbing';
    });
    window.addEventListener('mousemove', function(e) {
      if (!isDragging) return;
      var dx = e.clientX - dragStartX;
      track.style.transform = 'translateX(' + (dragStartTranslate + dx) + 'px)';
    });
    window.addEventListener('mouseup', function(e) {
      if (!isDragging) return;
      isDragging = false;
      slider.style.cursor = 'grab';
      track.style.transition = 'transform 0.5s ease';
      var dx = e.clientX - dragStartX;
      var slideW = slides[0].offsetWidth;
      if (dx < -50) goTo(currentIdx + 1);
      else if (dx > 50) goTo(currentIdx - 1);
      else goTo(currentIdx);
    });
    // Touch
    slider.addEventListener('touchstart', function(e) {
      isDragging = true;
      dragStartX = e.touches[0].clientX;
      var m = track.style.transform.match(/translateX\((.+)px\)/);
      dragStartTranslate = m ? parseFloat(m[1]) : 0;
      track.style.transition = 'none';
    }, { passive: true });
    slider.addEventListener('touchmove', function(e) {
      if (!isDragging) return;
      var dx = e.touches[0].clientX - dragStartX;
      track.style.transform = 'translateX(' + (dragStartTranslate + dx) + 'px)';
    }, { passive: true });
    slider.addEventListener('touchend', function(e) {
      if (!isDragging) return;
      isDragging = false;
      track.style.transition = 'transform 0.5s ease';
      var dx = (e.changedTouches[0]?.clientX || 0) - dragStartX;
      if (dx < -50) goTo(currentIdx + 1);
      else if (dx > 50) goTo(currentIdx - 1);
      else goTo(currentIdx);
    });

    // Click slide to activate
    slides.forEach(function(slide, i) {
      slide.addEventListener('click', function() {
        if (Math.abs(dragStartX - (window._lastMouseX || dragStartX)) > 5) return; // ignore drag
        goTo(i);
      });
    });
    window.addEventListener('mousemove', function(e) { window._lastMouseX = e.clientX; });

    // Trackpad horizontal swipe (wheel deltaX)
    var wheelTimeout, wheelAccum = 0;
    slider.addEventListener('wheel', function(e) {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault();
      wheelAccum += e.deltaX;
      clearTimeout(wheelTimeout);
      wheelTimeout = setTimeout(function() {
        if (wheelAccum > 40) goTo(currentIdx + 1);
        else if (wheelAccum < -40) goTo(currentIdx - 1);
        wheelAccum = 0;
      }, 80);
    }, { passive: false });

    // Init
    perView = getPerView();
    buildDots();
    goTo(0);
    slider.style.cursor = 'grab';

    window.addEventListener('resize', function() {
      perView = getPerView();
      buildDots();
      goTo(Math.min(currentIdx, getMaxIdx()));
    });
  })();

  // === FAQ ACCORDION ===
  (function() {
    document.querySelectorAll('.faq-question').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var item = btn.closest('.faq-item');
        var answer = item.querySelector('.faq-answer');
        var isOpen = item.classList.contains('is-open');
        // Close all
        document.querySelectorAll('.faq-item.is-open').forEach(function(open) {
          open.classList.remove('is-open');
          open.querySelector('.faq-answer').style.maxHeight = '0';
          open.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
        });
        // Open clicked if it was closed
        if (!isOpen) {
          item.classList.add('is-open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();

  // === PLATFORM TABS ===
  (function() {
    var tabs = document.querySelectorAll('.plt-tab');
    var mainImg = document.getElementById('plt-main-img');
    if (!tabs.length || !mainImg) return;
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('plt-tab-active'); });
        tab.classList.add('plt-tab-active');
        mainImg.src = tab.dataset.img;
        mainImg.alt = tab.querySelector('.plt-tab-title').textContent;
      });
    });
  })();

  // === NAV SCROLL EFFECT ===
  (function() {
    var nav = document.querySelector('.CuNavigation_navigation__zryLb');
    if (!nav) return;
    function checkScroll() {
      if (window.scrollY > 50) {
        nav.classList.add('nav-scrolled');
      } else {
        nav.classList.remove('nav-scrolled');
      }
    }
    window.addEventListener('scroll', checkScroll, { passive: true });
    checkScroll();
  })();

  // === VIDEO HERO WORD CYCLING ===
  (function() {
    var words = ['follow-ups', 'booking', 'project coordination', 'invoicing'];
    var wordEl = document.getElementById('vh-cycling-word');
    if (!wordEl) return;
    var currentIdx = 0;
    var gradientColors = ['#eca8d6', '#a78bfa', '#67e8f9', '#fbbf24', '#eca8d6'];

    function hexToRgb(hex) {
      return [parseInt(hex.slice(1,3),16), parseInt(hex.slice(3,5),16), parseInt(hex.slice(5,7),16)];
    }

    function renderWord(word) {
      wordEl.innerHTML = '';
      var letters = word.split('');
      letters.forEach(function(char, i) {
        var span = document.createElement('span');
        span.className = 'vh-letter';
        if (char === ' ') { span.innerHTML = '&nbsp;'; } else { span.textContent = char; }
        // Gradient color
        var t = letters.length > 1 ? i / (letters.length - 1) : 0;
        var ci = t * (gradientColors.length - 1);
        var lo = Math.floor(ci), hi = Math.min(lo + 1, gradientColors.length - 1);
        var f = ci - lo;
        var c1 = hexToRgb(gradientColors[lo]), c2 = hexToRgb(gradientColors[hi]);
        var r = Math.round(c1[0] + (c2[0]-c1[0])*f);
        var g = Math.round(c1[1] + (c2[1]-c1[1])*f);
        var b = Math.round(c1[2] + (c2[2]-c1[2])*f);
        span.style.color = 'rgb('+r+','+g+','+b+')';
        wordEl.appendChild(span);
        // Stagger reveal
        setTimeout(function() { span.classList.add('vh-shown'); }, i * 45);
      });
      // Fade gradient to white after all letters revealed
      setTimeout(function() {
        wordEl.querySelectorAll('.vh-letter').forEach(function(l) { l.style.color = '#111'; });
      }, letters.length * 45 + 700);
    }

    renderWord(words[0]);
    setInterval(function() {
      currentIdx = (currentIdx + 1) % words.length;
      renderWord(words[currentIdx]);
    }, 2500);
  })();

  // Smooth scroll for nav links
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const target = document.querySelector(a.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      const y = target.getBoundingClientRect().top + window.scrollY - 80;
      window.scrollTo({ top: y, behavior: 'smooth' });
    });
  });

  // === HERO: Sync bubbles to character position ===
  function syncBubbles() {
    const actor = document.querySelector('.AgentHeroPin_actor__YseDE');
    const stage = document.querySelector('.CanvaStage_canvaStage__ACZ2c');
    const bubbles = document.querySelectorAll('.bubble');
    if (!actor || !stage || bubbles.length === 0) return;

    const ar = actor.getBoundingClientRect();
    const sr = stage.getBoundingClientRect();

    // Exact ratios — pull inward on narrow viewports
    const vw = window.innerWidth;
    const squeeze = vw < 1200 ? Math.max(0, (1200 - vw) / 1200) * 0.15 : 0;
    const positions = [
      { left: 0.02 + squeeze,  top: 0.08 },   // tl
      { left: 0.85 - squeeze,  top: 0.08 },   // tr
      { left: -0.15 + squeeze * 1.5, top: 0.32 },   // ml
      { left: 0.98 - squeeze * 1.5,  top: 0.32 },   // mr
      { left: -0.05 + squeeze, top: 0.55 },   // bl
      { left: 0.88 - squeeze,  top: 0.55 },   // br
    ];
    // Portrait phones: big bubbles, stage-relative positions
    if (window.innerWidth <= 800 && window.innerHeight > window.innerWidth * 1.1) {
      const stageW = sr.width;
      const stageH = sr.height;
      const bSize = stageW * (stageW < 380 ? 0.17 : 0.22);
      // Calculate row gap from actual bubble size + 16px breathing room
      var rowGap = (bSize + 16) / stageH;
      var topStart = Math.max(0.18, 90 / stageH);
      const portraitPositions = [
        { left: 0.02, top: topStart },
        { left: 0.76, top: topStart },
        { left: -0.02, top: topStart + rowGap },
        { left: 0.80, top: topStart + rowGap },
        { left: 0.02, top: topStart + rowGap * 2 },
        { left: 0.76, top: topStart + rowGap * 2 },
      ];
      bubbles.forEach((bubble, i) => {
        if (!portraitPositions[i]) return;
        const p = portraitPositions[i];
        var bLeft = stageW * p.left;
        bLeft = Math.max(8, Math.min(bLeft, stageW - bSize - 8));
        bubble.style.left = bLeft + 'px';
        bubble.style.top = (stageH * p.top) + 'px';
        bubble.style.width = bSize + 'px';
      });
      return;
    }

    // On small landscape screens, use straight-line grid positions instead of arc
    if (window.innerWidth <= 480) {
      const stageW = sr.width;
      const stageH = sr.height;
      const bSize = stageW * 0.16;
      const gridPositions = [
        { left: 0.08, top: 0.16 },  // tl
        { left: 0.74, top: 0.16 },  // tr
        { left: 0.06, top: 0.29 },  // ml
        { left: 0.76, top: 0.29 },  // mr
        { left: 0.08, top: 0.42 },  // bl
        { left: 0.74, top: 0.42 },  // br
      ];
      bubbles.forEach((bubble, i) => {
        if (!gridPositions[i]) return;
        const p = gridPositions[i];
        bubble.style.left = (stageW * p.left) + 'px';
        bubble.style.top = (stageH * p.top) + 'px';
        bubble.style.width = bSize + 'px';
      });
      return;
    }

    // Account for max-height cap: visible image may be smaller than element
    const imgRatio = 1.14; // image natural width/height ratio
    const visibleH = Math.min(ar.height, ar.height);
    const visibleW = Math.min(ar.width, visibleH * imgRatio);
    const offsetX = (ar.width - visibleW) / 2; // center offset if image is narrower
    const bubbleSize = visibleW * 0.18;

    var minPad = 12; // minimum gap from stage edges in px
    bubbles.forEach((bubble, i) => {
      if (!positions[i]) return;
      const p = positions[i];
      var rawLeft = ar.left - sr.left + offsetX + visibleW * p.left;
      rawLeft = Math.max(minPad, Math.min(rawLeft, sr.width - bubbleSize - minPad));
      bubble.style.left = rawLeft + 'px';
      bubble.style.top = (ar.top - sr.top + visibleH * p.top) + 'px';
      bubble.style.width = bubbleSize + 'px';
    });
  }
  // === HERO: Sync CTA to character position ===
  function syncCTA() {
    const actor = document.querySelector('.AgentHeroPin_actor__YseDE');
    const stage = document.querySelector('.CanvaStage_canvaStage__ACZ2c');
    const cta = document.querySelector('.AgentHeroPin_ctaWrapper__Hzo48');
    if (!actor || !stage || !cta) return;

    const ar = actor.getBoundingClientRect();
    const sr = stage.getBoundingClientRect();

    // Position CTA relative to character — tighter on narrow viewports
    const isPortrait = window.innerHeight > window.innerWidth * 1.1;
    if (isPortrait && window.innerWidth <= 800) {
      // Portrait phones: anchor CTA from bottom of stage so it never overflows
      cta.style.top = 'auto';
      cta.style.bottom = '20px';
      return;
    }
    const ctaPct = window.innerWidth <= 800 ? 0.78
      : window.innerWidth < 1200 ? 0.72 : 0.75;
    const ctaY = ar.top - sr.top + ar.height * ctaPct;
    cta.style.top = ctaY + 'px';
  }

  syncBubbles();
  syncCTA();
  document.querySelectorAll('.bubble').forEach(b => { b.style.opacity = '1'; b.style.transition = 'opacity 0.3s'; });
  window.addEventListener('resize', () => { syncBubbles(); syncCTA(); });
  window.addEventListener('load', () => { syncBubbles(); syncCTA(); });

  // === Bubble float animation ===
  (function() {
    const bubbles = document.querySelectorAll('.bubble');
    const delays = [0, 0.5, 1.0, 1.5, 2.0, 2.5];
    const amplitude = 14;
    const duration = 3000;
    function animateBubbles(time) {
      bubbles.forEach((b, i) => {
        const t = (time + delays[i] * 1000) % duration;
        const y = Math.sin((t / duration) * Math.PI * 2) * amplitude;
        b.style.transform = 'translateY(' + y + 'px)';
      });
      requestAnimationFrame(animateBubbles);
    }
    requestAnimationFrame(animateBubbles);
  })();

  // === Character mouse-follow parallax (desktop only) ===
  (function() {
    if ('ontouchstart' in window) return;
    const actor = document.querySelector('.AgentHeroPin_actor__YseDE');
    if (!actor) return;
    var targetX = 0, targetY = 0, currentX = 0, currentY = 0;
    window.addEventListener('mousemove', (e) => {
      var cx = window.innerWidth / 2;
      var cy = window.innerHeight / 2;
      targetX = ((e.clientX - cx) / cx) * 15;
      targetY = ((e.clientY - cy) / cy) * 10;
    });
    function animate() {
      currentX += (targetX - currentX) * 0.05;
      currentY += (targetY - currentY) * 0.05;
      actor.style.transform = 'translate(' + currentX + 'px, ' + currentY + 'px)';
      requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);
  })();

  // === Fade character as powers section scrolls into view (mobile only) ===
  (function() {
    if (window.innerWidth > 800 || window.innerHeight <= window.innerWidth * 1.1) return;
    const actor = document.querySelector('.AgentHeroPin_actor__YseDE');
    const features = document.querySelector('.AgentHeroPin_agentFeatures__jxcjg');
    if (!actor || !features) return;
    window.addEventListener('scroll', () => {
      const fr = features.getBoundingClientRect();
      const vh = window.innerHeight;
      const progress = Math.max(0, Math.min(1, (vh - fr.top) / (vh * 0.5)));
      actor.style.opacity = 1 - progress * 0.5;
    }, { passive: true });
  })();


  // === EXPANDABLE TAGS ===
  document.querySelectorAll('[data-expandable-tag]').forEach(tag => {
    tag.addEventListener('click', () => {
      const expanded = tag.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('[data-expandable-tag][aria-expanded="true"]').forEach(t => {
        if (t !== tag) t.setAttribute('aria-expanded', 'false');
      });
      tag.setAttribute('aria-expanded', expanded ? 'false' : 'true');
    });
  });

  // === EXPANDABLE PILLS — click to expand + dialog typewriter + image swap ===
  const pillTexts = {
    "send-email": "I'll write an email to our vendor to ensure we're on track.",
    "direct-message": "Message me like any teammate for 1:1 assistance.",
    "assign-task": "Assign me to a task so I can get to work and keep you updated.",
    "schedule-events": "Tag me in anywhere and I'll schedule events for you.",
    "mentions": "@Mention me in tasks, docs, and chats to ask anything."
  };
  const pillImages = {
    "send-email": "/images/email_dummy.webp",
    "direct-message": "/images/ai-agent-tab-image-chat.webp",
    "assign-task": "/images/ai-agent-tab-image-assign.webp",
    "schedule-events": "/images/ai-agent-tab-image-events.webp",
    "mentions": "/images/ai-agent-tab-image-mentions.webp"
  };
  let pillTypeInterval = null;

  function activatePill(pill) {
    // Collapse others
    document.querySelectorAll('[data-expandable-pill][aria-expanded="true"]').forEach(p => {
      if (p !== pill) p.setAttribute('aria-expanded', 'false');
    });
    pill.setAttribute('aria-expanded', 'true');

    const visualId = pill.getAttribute('data-visual-id');
    const showcase = pill.closest('[data-pill-showcase]');
    if (!showcase || !visualId) return;

    // Typewriter on dialog
    const textEl = showcase.querySelector('.dialog-text');
    const dialogBox = showcase.querySelector('.agent-dialog');
    if (textEl && dialogBox && pillTexts[visualId]) {
      if (pillTypeInterval) clearInterval(pillTypeInterval);
      const words = pillTexts[visualId].split(/(\s+)/);
      textEl.innerHTML = words.map(w => '<span style="visibility:hidden">' + w + '</span>').join('');
      gsap.fromTo(dialogBox, {y: 30, opacity: 0}, {y: 0, opacity: 1, duration: 0.3, ease: 'power2.out'});
      let wordIdx = 0;
      const spans = textEl.querySelectorAll('span');
      pillTypeInterval = setInterval(() => {
        if (wordIdx >= spans.length) { clearInterval(pillTypeInterval); pillTypeInterval = null; return; }
        spans[wordIdx].style.visibility = 'visible';
        wordIdx++;
      }, 60);
    }
  }

  document.querySelectorAll('[data-expandable-pill]').forEach(pill => {
    pill.addEventListener('click', () => activatePill(pill));
  });

  // Auto-activate first pill on scroll into view
  const pillShowcase = document.querySelector('[data-pill-showcase]');
  if (pillShowcase) {
    const firstPill = pillShowcase.querySelector('[data-expandable-pill]');
    const pillObs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && firstPill) {
          activatePill(firstPill);
          pillObs.disconnect();
        }
      });
    }, { threshold: 0.3 });
    pillObs.observe(pillShowcase);
  }

  // === CAPABILITIES TABS ===
