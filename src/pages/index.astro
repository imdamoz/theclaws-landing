<script is:inline>
  // Scroll-driven fade for DNA & Matrix
  (function init() {
    var decos = document.querySelectorAll('.powers-deco');
    if (!decos.length) {
      // Elements not in DOM yet, retry
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        setTimeout(init, 100);
      }
      return;
    }
    var section = document.querySelector('.hp-pills');
    if (!section) return;

    var startScroll = 700;
    var fullScroll = 800;
    var fadeOutStart = 1600;
    var fadeOutEnd = 2200;

    function tick() {
      var y = window.scrollY;
      var fadeIn = Math.max(0, Math.min(1, (y - startScroll) / (fullScroll - startScroll)));
      var fadeOut = y > fadeOutStart ? Math.max(0, 1 - (y - fadeOutStart) / (fadeOutEnd - fadeOutStart)) : 1;
      var opacity = fadeIn * fadeOut * 0.9;
      for (var i = 0; i < decos.length; i++) { decos[i].style.setProperty("--deco-opacity", opacity); }
      requestAnimationFrame(tick);

    // JS-driven bounce (bypasses prefers-reduced-motion)
    var bounceStart = performance.now();
    function bounce() {
      var t = (performance.now() - bounceStart) / 3000; // 3s period
      var y = Math.sin(t * Math.PI * 2) * -7; // -7px amplitude
      for (var b = 0; b < decos.length; b++) {
        decos[b].style.transform = 'translateY(' + y + 'px)';
      }
      requestAnimationFrame(bounce);
    }
    requestAnimationFrame(bounce);
    }
    requestAnimationFrame(tick);


  })();
</script>

