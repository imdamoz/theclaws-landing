<script is:inline>
(function(){
  function initVideos() {
    var videos = document.querySelectorAll('.feature-icon-video');
    if (!videos.length) { setTimeout(initVideos, 300); return; }
    
    var isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0) || (window.innerWidth <= 1024);
    
    if (isTouchDevice) {
      // Auto-loop all videos on mobile/tablet
      videos.forEach(function(v) {
        v.loop = true;
        v.muted = true;
        v.play().catch(function(){});
      });
    } else {
      // Hover to play on desktop
      document.querySelectorAll('.feature-col').forEach(function(col) {
        var video = col.querySelector('.feature-icon-video');
        if (!video) return;
        col.addEventListener('mouseenter', function() {
          video.currentTime = 0;
          video.loop = true;
          video.play().catch(function(){});
        });
        col.addEventListener('mouseleave', function() {
          video.pause();
          video.currentTime = 0;
        });
      });
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideos);
  } else {
    setTimeout(initVideos, 300);
  }
})();
</script>



