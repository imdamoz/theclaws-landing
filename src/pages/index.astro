// === AGENT CARD FOOTER INJECTION ===
(function() {
  var cardRoles = {
    'Eve':  'Inbox + Calendar',
    'Max':  'Reply + Book Calls',
    'Mia':  'Tasks + Deadlines + Follow-Ups',
    'Zara': 'Helpdesk + Tickets',
    'Sora': 'Prospecting + LinkedIn Outbound',
    'Kai':  'Invoices + Payroll + Runway'
  };
  var cardLive = { 'Eve': true, 'Max': true, 'Mia': true, 'Zara': false, 'Sora': false, 'Kai': false };
  function injectFooters() {
    var cards = document.querySelectorAll('.AgentCarousel_carouselCard__kfTd9');
    if (!cards.length) { setTimeout(injectFooters, 200); return; }
    cards.forEach(function(card) {
      if (card.querySelector('.card-footer')) return;
      var titleEl = card.querySelector('.AgentCarousel_cardTitle__EmvK2');
      if (!titleEl) return;
      var name = titleEl.textContent.trim();
      var role = cardRoles[name] || '';
      var live = cardLive[name] !== false;
      var dotColor = live ? '#22c55e' : '#ef4444';
      var statusLabel = live ? 'Live' : 'Coming soon';
      var iconEl = card.querySelector('.card-icon');
      var iconHTML = iconEl ? iconEl.outerHTML : '';
      var footer = document.createElement('div');
      footer.className = 'card-footer';
      footer.innerHTML = '<div class="card-footer-left"><div class="card-footer-top">' + iconHTML + '<span class="card-footer-name">' + name + '</span></div><span class="card-footer-role">' + role + '</span></div><div class="card-status-pill"><span class="card-status-dot" style="background:' + dotColor + ';"></span>' + statusLabel + '</div>';
      card.appendChild(footer);
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', injectFooters);
  } else {
    injectFooters();
  }
})();
</script>
