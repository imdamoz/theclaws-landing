        <div class="eve-number-item">
          <span class="label-top">Available</span>
          <span class="big-num">24/7</span>
          <span class="label-bottom">on web and mobile</span>
        </div>
        <div class="eve-number-item">
          <span class="label-top">More than</span>
          <span class="big-num">10+ hrs</span>
          <span class="label-bottom">saved per week on admin</span>
        </div>
        <div class="eve-number-item">
          <span class="label-top">Up to</span>
          <span class="big-num">70%</span>
          <span class="label-bottom">faster lead response</span>
        </div>
      </div>
    </div>
    <img src="/images/executive-assistant.webp" alt="Eve — AI Executive Assistant" class="eve-numbers-image" />
  </div>
</section>



