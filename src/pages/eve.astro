<!-- Loop animation script -->
<script is:inline>
(function() {
  var initialized = false;
  function initEveLoop() {
    if (initialized) return;
    initialized = true;
    document.querySelectorAll('.eve-loop-row').forEach(function(row) {
      var original = row.querySelector('.eve-loop-group');
      if (!original) return;
      for (var i = 0; i < 2; i++) {
        var clone = original.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        row.appendChild(clone);
      }
      row.classList.add('loop-ready');
    });
  }
  document.addEventListener('scroll', initEveLoop, { once: true, passive: true });
  document.addEventListener('mousemove', initEveLoop, { once: true, passive: true });
  setTimeout(initEveLoop, 3000);
})();
</script>

<!-- Brain AI photo pack scroll animation -->
<script is:inline>
document.addEventListener("DOMContentLoaded", function() {
  if (!window.gsap || !window.ScrollTrigger) return;
  gsap.registerPlugin(ScrollTrigger);

  var img = document.querySelector(".helper-lp-images_image");
  if (!img) return;

  gsap.set(img, { opacity: 0, y: -600, scale: 1.5 });

  gsap.to(img, {
    opacity: 1,
    y: 0,
    scale: 1,
    duration: 1,
    ease: "power2.out",
    scrollTrigger: {
      trigger: ".helper-lp-folder_content",
      start: "top 90%",
      end: "center 50%",
      scrub: 1
    }
  });
});
</script>

