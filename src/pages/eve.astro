  <!-- Inspiration3 CSS (for testimonial cards) -->
  <link rel="stylesheet" href="/inspiration3/css/sintraweb.shared.61297f412.min.css" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Inspiration CSS (for Brain AI / folder sections) -->
  <link rel="stylesheet" href="/inspiration/css/sintraweb.shared.61297f412.min.css" />

  <!-- GSAP for Brain AI scroll animation -->
  <script is:inline src="/inspiration/js/gsap.min_1.js"></script>
  <script is:inline src="/inspiration/js/ScrollTrigger.min_1.js"></script>

  <style is:global>
    /* === BASE === */
    *, *::before, *::after { box-sizing: border-box; }

    /* === GRADIENT FIX === */
    .helper-lp_sharpness-image { display: none !important; }
    .section_helper-lp-blue-gradient-container { overflow: visible !important; background: transparent !important; }
    .helper-lp_blue-bg-gradient {
      height: 240% !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      z-index: 0 !important;
    }

    /* Brain AI section - spacing between elements */
    .helper-lp-folder_heading {
      margin-bottom: 6rem;
    }
    .helper-lp-folder_content {
      height: 48rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .helper-lp-folder_folder-wrap {
      top: 7.063rem;
    }
    .helper-lp-images_image {
      width: 33rem !important;
      height: 17rem !important;
    }
    .section_helper-lp-knowledge {
      padding-top: 5rem;
    }
    .helper-lp-knowledge_heading {
      margin-bottom: 5rem;
    }
    /* Loved section - full-width horizontal carousel */
    .helper-lp-loved_content {
      width: 100vw !important;
      margin-left: calc(-50vw + 50%) !important;
      padding-left: 5vw;
      padding-right: 5vw;
      overflow: visible !important;
    }
    .helper-lp-loved_card-list {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      overflow-y: visible !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 1rem;
      padding-bottom: 1rem;
      scrollbar-width: none;
    }
    .helper-lp-loved_card-list::-webkit-scrollbar {
      display: none;
    }
    .helper-lp-loved_card {
      flex: 0 0 22rem !important;
      scroll-snap-align: start;
      min-width: 22rem;
      border-radius: 1.25rem;
      overflow: hidden !important;
      background: #f5f5f5 !important;
    }
    .helper-lp-loved_card-top {
      padding: 1.5rem 1.25rem !important;
    }
    .helper-lp-loved_card-top h3 {
      font-size: 1.35rem !important;
    }
    .helper-lp-loved_card-top p {
      font-size: 0.85rem !important;
    }
    .helper-lp-loved_card-visual {
      height: 20rem !important;
      overflow: hidden !important;
    }
    .helper-lp-loved_card-image {
      object-fit: cover !important;
      width: 100% !important;
      height: 100% !important;
    }

    .helper-lp-knowledge_content {
      margin-top: 3rem;
    }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #1a1a1a;
      background: #fff;
      -webkit-font-smoothing: antialiased;
    }

    /* === STICKY HEADER (no nav) === */
    .eve-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(0,0,0,0.94);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 32px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .eve-header .logo {
      font-weight: 800;
      font-size: 20px;
      color: #fff;
      text-decoration: none;
      letter-spacing: -0.02em;
    }
    .eve-header .header-cta {
      background: #fff;
      color: #000;
      padding: 10px 24px;
      border-radius: 50px;
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
      transition: transform 0.15s;
    }
    .eve-header .header-cta:hover { transform: translateY(-1px); }

    /* === NUMBERS / STATS SECTION === */
    .eve-numbers {
      position: relative;
      padding: 100px 60px;
      overflow: hidden;
      background: #fafafa;
    }
    .eve-numbers-wrap {
      position: relative;
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .eve-numbers-left h2 {
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
      color: #1a1a1a;
      max-width: 520px;
    }
    .eve-numbers-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-top: 48px;
    }
    .eve-number-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .eve-number-item .label-top {
      font-size: 16px;
      opacity: 0.6;
    }
    .eve-number-item .big-num {
      font-size: clamp(36px, 4vw, 52px);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }
    .eve-number-item .label-bottom {
      font-size: 14px;
      opacity: 0.5;
    }
    .eve-numbers-image {
      width: 100%;
      max-width: 550px;
      height: auto;
      object-fit: contain;
      justify-self: end;
    }

    /* === COMPARISON TABLE === */
    .eve-compare {
      padding: 80px 60px;
      background: #fff;
    }
    .eve-compare-inner {
      max-width: 1200px;
      margin: 0 auto;
    }
    .eve-compare-sub {
      text-align: center;
      font-size: 16px;
      opacity: 0.6;
      margin-bottom: 48px;
    }
    .eve-compare-logos {
      display: grid;
      grid-template-columns: 200px repeat(4, 1fr);
      gap: 0;
      margin-bottom: 8px;
      align-items: end;
      padding-bottom: 16px;
    }
    .eve-compare-logos span {
      text-align: center;
      font-size: 12px;
      font-weight: 700;
    }
    .eve-compare-logos span:first-child { text-align: left; }
    .eve-compare-logos .logo-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #f0f0f0;
      margin: 0 auto 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .eve-compare-logos .logo-icon.eve-icon {
      background: none;
      border: 2px solid #1a1a1a;
    }
    .eve-compare-row {
      display: grid;
      grid-template-columns: 200px repeat(4, 1fr);
      gap: 0;
      padding: 16px 0;
      border-top: 1px solid #f0f0f0;
      align-items: center;
    }
    .eve-compare-row .feature-name {
      font-size: 14px;
      font-weight: 500;
    }
    .eve-compare-row .cell {
      text-align: center;
    }
    .eve-compare-row .cell span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      font-size: 14px;
      font-weight: 700;
    }
    .eve-compare-row .cell.yes span {
      background: #22c55e;
      color: #fff;
    }
    .eve-compare-row .cell.no span {
      background: #ef4444;
      color: #fff;
    }

    @media (max-width: 768px) {
      .eve-compare { padding: 60px 20px; }
      .eve-compare-logos,
      .eve-compare-row { grid-template-columns: 120px repeat(4, 1fr); }
      .eve-compare-row .feature-name { font-size: 12px; }
    }

    /* === CAPABILITY LOOP CARDS === */
    .eve-loop {
      background: transparent;
      padding: 80px 0;
      margin-top: 80px;
      border-top: none;
      overflow: hidden;
      position: relative;
      z-index: 1;
    }
    .eve-loop-header {
      text-align: center;
      padding: 0 24px;
      margin-bottom: 48px;
    }
    .eve-loop-header h2 {
      font-size: clamp(28px, 3.5vw, 42px);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #1a1a1a;
    }
    .eve-loop-header p {
      font-size: 16px;
      opacity: 0.6;
      margin-top: 12px;
    }
    .eve-loop-rows {
      overflow: hidden;
      width: 100%;
    }
    .eve-loop-row {
      display: flex;
      padding: 8px 0;
      width: max-content;
    }
    .eve-loop-row.loop-ready .eve-loop-group.normal {
      animation: eveScrollLeft 40s linear infinite;
    }
    .eve-loop-row.loop-ready .eve-loop-group.reverse {
      animation: eveScrollRight 40s linear infinite;
    }
    @keyframes eveScrollLeft {
      0% { transform: translateX(0); }
      100% { transform: translateX(-100%); }
    }
    @keyframes eveScrollRight {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(0); }
    }
    .eve-loop-group {
      display: flex;
      flex-shrink: 0;
    }
    .eve-loop-group > * {
      margin-right: 16px;
    }
    .eve-loop-card {
      background: rgba(245, 245, 245, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: none;
      border-radius: 16px;
      padding: 28px;
      width: 280px;
      flex-shrink: 0;
      position: relative;
      z-index: 2;
    }
    .eve-loop-card .card-icon {
      width: 36px;
      height: 36px;
      margin-bottom: 14px;
      font-size: 24px;
    }
    .eve-loop-card h3 {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 6px;
      color: #1a1a1a;
    }
    .eve-loop-card p {
      font-size: 13px;
      color: #666;
      line-height: 1.5;
    }

    @media (max-width: 768px) {
      .eve-header { padding: 14px 20px; }
      .eve-numbers { padding: 60px 20px; }
      .eve-numbers-wrap { grid-template-columns: 1fr; gap: 40px; }
      .eve-numbers-image { max-width: 300px; justify-self: center; }
      .eve-numbers-grid { gap: 24px; }
    }
  </style>
</head>
