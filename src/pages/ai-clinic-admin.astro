---
import Layout from '../layouts/Layout.astro';
import '../styles/ai-mortgage-admin/styles.css';
import '../styles/ai-mortgage-admin/sections.css';
import '../styles/ai-mortgage-admin/motion.css';
---

<Layout
  title="Mia Clinic Admin — More patients seen. Less time lost on paperwork."
  description="Connect the patient file. Mia Clinic Admin reviews records, medications and follow-ups, and drafts the patient and clinician chases for whatever is missing."
  ogTitle="Mia Clinic Admin — More patients seen. Less time lost on paperwork."
  ogDescription="Connect the patient file. Mia Clinic Admin reviews records, medications and follow-ups, and drafts the patient and clinician chases for whatever is missing."
  includeHomeStyles={false}
>

<style is:global>
  /* Per-page accent override — pink for Mia (clinic). */
  :root {
    --lime: #FF5CA0;
    --lime-2: #E63A8A;
    --lime-ink: #FFFFFF;
    --lime-rgb: 255, 92, 160;
  }

  /* ===== Hero v2 (4-card layout) — Mia Clinic Admin ===== */
  .hero-stage .agent { width: 80%; margin-top: 0; }
  .hero-stage .sbubble { display: none; }

  .hero-stage .fcard-tasks,
  .hero-stage .fcard-workflows,
  .hero-stage .fcard-meds,
  .hero-stage .fcard-reminder {
    position: absolute;
    background: var(--surface);
    border-radius: 11px;
    padding: 10px;
    box-shadow: 0 12px 26px -10px rgba(9,9,11,0.16), 0 1px 3px -1px rgba(9,9,11,0.05);
    border: 1px solid rgba(225, 227, 226, 0.6);
    font-family: var(--font-body);
  }
  .hero-stage .fcard-tasks     { top: 30px;   left: 0;    width: 200px; transform: rotate(-1deg); z-index: 4; }
  .hero-stage .fcard-workflows { top: 12px;   right: 0;   width: 198px; transform: rotate(2deg);  z-index: 5; }
  .hero-stage .fcard-meds      { bottom: 60px; left: 0;   width: 204px; transform: rotate(3deg);  z-index: 5; }
  .hero-stage .fcard-reminder  { bottom: 30px; right: 0;  width: 220px; transform: rotate(-2deg); z-index: 4; }

  @media (max-width: 820px) {
    .hero-stage .fcard-tasks     { top: 30px;   left: 4px;  width: 180px; }
    .hero-stage .fcard-workflows { top: 10px;   right: 4px; width: 180px; }
    .hero-stage .fcard-meds      { bottom: 50px; left: 4px; width: 180px; }
    .hero-stage .fcard-reminder  { bottom: 20px; right: 4px; width: 200px; }
  }

  /* ----- Shared header ----- */
  .clc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 9px;
  }
  .clc-head-left { display: flex; align-items: center; gap: 6px; min-width: 0; flex: 1; }
  .clc-icon-box {
    width: 22px; height: 22px;
    border-radius: 6px;
    background: rgba(var(--lime-rgb), 0.10);
    color: var(--lime);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .clc-icon-box svg { width: 12px; height: 12px; }
  .clc-icon-box.danger { background: #FFDAD6; color: #93000A; }
  .clc-icon-box.danger svg { width: 12px; height: 12px; }
  .clc-title-block { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
  .clc-title {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .clc-title.accent { color: var(--lime); }
  .clc-sub {
    font-size: 7.5px;
    color: var(--fg-3);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .clc-tag {
    font-family: var(--font-body);
    font-size: 8px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .clc-tag-active { background: rgba(108, 248, 187, 0.30); color: #00714D; }
  .clc-tag-active::before {
    content: '';
    width: 4px; height: 4px;
    border-radius: 50%;
    background: #006C49;
  }
  .clc-tag-open { background: var(--lime); color: var(--lime-ink); font-weight: 500; font-family: var(--font-body); }
  .clc-tag-alerts { background: rgba(186, 26, 26, 0.10); color: #BA1A1A; }
  .clc-tag-draft { background: var(--surface-3); color: var(--ink); font-weight: 600; }

  /* ----- Follow-up Tasks card ----- */
  .clc-task-list { display: flex; flex-direction: column; gap: 6px; }
  .clc-task-row {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    padding: 7px;
    background: rgba(168,168,168,0.08);
    border-radius: 7px;
  }
  .clc-task-icon {
    width: 19px; height: 19px;
    background: var(--surface);
    border-radius: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0.5px 1px rgba(0,0,0,0.05);
    color: var(--lime);
  }
  .clc-task-icon svg { width: 11px; height: 11px; }
  .clc-task-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
  .clc-task-name { font-family: var(--font-display); font-size: 9px; font-weight: 600; color: var(--ink); line-height: 1.3; }
  .clc-task-meta { font-size: 7.5px; color: var(--fg-3); line-height: 1.3; }

  /* ----- Workflows card (status rows) ----- */
  .clc-status-list { display: flex; flex-direction: column; gap: 6px; }
  .clc-status-row { display: flex; align-items: flex-start; gap: 7px; }
  .clc-status-icon {
    width: 16px; height: 16px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .clc-status-icon.danger { background: rgba(255, 218, 214, 0.50); color: #BA1A1A; }
  .clc-status-icon.neutral { background: var(--surface-3); color: #004532; }
  .clc-status-icon.success { background: rgba(108, 248, 187, 0.30); color: #006C49; }
  .clc-status-icon svg { width: 9px; height: 9px; }
  .clc-status-body { flex: 1; min-width: 0; }
  .clc-status-row-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
  }
  .clc-status-name {
    font-family: var(--font-display);
    font-size: 8.5px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .clc-status-meta { font-size: 7px; color: var(--fg-3); line-height: 1.3; }
  .clc-status-pill {
    font-family: var(--font-body);
    font-size: 7px;
    font-weight: 500;
    padding: 1px 5px;
    border-radius: 2px;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .clc-status-pill-detected { background: rgba(255, 218, 214, 0.50); color: #BA1A1A; }
  .clc-status-pill-queued { background: var(--surface-3); color: #004532; }
  .clc-status-pill-drafted { background: var(--surface-3); color: var(--fg-3); }
  .clc-status-pill-suggested { background: rgba(108, 248, 187, 0.30); color: #006C49; }
  .clc-review-link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-top: 8px;
    margin-left: auto;
    font-size: 8px;
    font-weight: 600;
    color: #004532;
    text-decoration: none;
  }
  .clc-review-link svg { width: 9px; height: 9px; }

  /* ----- Medication Check card ----- */
  .clc-meds-box {
    background: rgba(168,168,168,0.08);
    border-radius: 7px;
    padding: 8px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-bottom: 6px;
  }
  .clc-meds-col { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .clc-meds-label {
    font-size: 6.5px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-3);
    line-height: 1.2;
  }
  .clc-meds-value {
    font-size: 9px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }
  .clc-alert-box {
    position: relative;
    background: #FFF7ED;
    border-radius: 7px;
    padding: 8px 8px 8px 11px;
    margin-bottom: 6px;
    overflow: hidden;
  }
  .clc-alert-box::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: rgba(249, 115, 22, 0.6);
  }
  .clc-alert-title {
    font-family: var(--font-display);
    font-size: 8px;
    font-weight: 600;
    color: #9A3412;
    line-height: 1.3;
    margin-bottom: 2px;
  }
  .clc-alert-body {
    font-size: 7.5px;
    color: rgba(120, 53, 15, 0.85);
    line-height: 1.4;
  }
  .clc-action-box {
    background: rgba(var(--lime-rgb), 0.10);
    border-radius: 7px;
    padding: 7px 8px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .clc-action-box svg { width: 11px; height: 11px; color: var(--lime); flex-shrink: 0; }
  .clc-action-text { font-size: 8px; color: var(--ink); line-height: 1.3; }
  .clc-action-text b { color: var(--lime); font-weight: 600; }
  .clc-btn-row { display: flex; gap: 6px; }
  .clc-btn-row > * { flex: 1; }
  .clc-btn-ghost {
    background: var(--surface-3);
    color: var(--lime-2);
    border: none;
    border-radius: 7px;
    padding: 6px 8px;
    font-family: var(--font-display);
    font-size: 8.5px;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
  }
  .clc-btn-primary {
    background: var(--lime);
    color: var(--lime-ink);
    border: none;
    border-radius: 7px;
    padding: 6px 8px;
    font-family: var(--font-display);
    font-size: 8.5px;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
  }

  /* ----- Patient Reminder card ----- */
  .clc-wa-icon {
    width: 22px; height: 22px;
    background: #25D366;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
  }
  .clc-wa-icon svg { width: 13px; height: 13px; }
  .clc-msg-label {
    font-size: 8px;
    font-weight: 700;
    color: var(--fg-3);
    line-height: 1.2;
    margin-bottom: 5px;
  }
  .clc-msg-box {
    background: #FFEFF6;
    border-radius: 6px;
    padding: 8px 9px;
    font-size: 8.5px;
    color: var(--ink);
    line-height: 1.5;
    margin-bottom: 8px;
  }
  .clc-msg-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }
  .clc-msg-to {
    font-size: 8px;
    color: var(--fg-3);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .clc-msg-to b { color: var(--ink); font-weight: 600; font-size: 9px; }
  .clc-send-btn {
    background: var(--lime);
    color: var(--lime-ink);
    border: none;
    border-radius: 999px;
    padding: 5px 12px;
    font-family: var(--font-display);
    font-size: 8.5px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    white-space: nowrap;
  }
  .clc-send-btn svg { width: 9px; height: 9px; }
</style>

<div class="scroll-progress"></div>
<a class="float-cta" href="#book"><span class="dot"></span>Book a call<span class="arrow">→</span></a>

<!-- NAV -->
<header class="wrap">
  <nav class="nav">
    <a class="nav-brand" href="#">
      <img src="/images/the-claws-logo.svg" alt="TheClaws" class="nav-brand-logo" />
      <span>Mia Clinic Admin</span>
    </a>
    <div class="nav-links">
      <a href="#problem">Problem</a>
      <a href="#how">How it works</a>
      <a href="#case">Case study</a>
      <a href="#incl">Included</a>
      <a href="#faq">FAQ</a>
    </div>
    <a class="btn btn-sm btn-primary" href="#book">Book a call <span class="arrow">→</span></a>
  </nav>
</header>

<!-- ============ HERO (all above fold) ============ -->
<section class="hero wrap">
  <div class="hero-left">
    <div class="eyebrow reveal"><span class="dot"></span>Patient workflows done in minutes, not hours</div>
    <h1 class="reveal reveal-delay-1">More patients seen.<br><span class="mark">Less time lost on paperwork.</span></h1>
    <p class="sub reveal reveal-delay-2">Connect the patient file. Mia Clinic Admin reviews records, medications and follow-ups, and drafts the patient and clinician chases for whatever is missing.</p>
    <div class="btns reveal reveal-delay-3">
      <a class="btn btn-lime btn-magnet" href="#book">Book a call &amp; see it on your clinic <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="#how">See how it works</a>
    </div>
    <p class="micro reveal reveal-delay-4">We'll review one live patient on the call and show the gaps it would flag — bring the chart, no prep needed.</p>

    <hr class="hero-divider reveal reveal-delay-4">

    <div class="hero-caps reveal reveal-delay-5">
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="16" y2="17"></line></svg>
        </span>
        <strong>Reads the whole record</strong>
        <span>Notes, prescriptions, labs, allergies, history, intake.</span>
      </div>
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        </span>
        <strong>Drafts the chase</strong>
        <span>Patient, GP, specialist, lab. You review before sending.</span>
      </div>
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </span>
        <strong>Fits your clinic's protocols</strong>
        <span>Your formulary, your safeguarding, your tone.</span>
      </div>
    </div>
  </div>

  <div class="hero-stage">
    <img class="agent" src="/images/mia-agent-ai-clinic-admin.png" alt="Mia Clinic Admin reviewing a patient record">

    <!-- Follow-up Tasks card -->
    <div class="fcard-tasks">
      <div class="clc-head">
        <div class="clc-title-block">
          <span class="clc-title">Follow-up Tasks</span>
        </div>
        <span class="clc-tag clc-tag-open">5 Open</span>
      </div>

      <div class="clc-task-list">
        <div class="clc-task-row">
          <span class="clc-task-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <div class="clc-task-text">
            <span class="clc-task-name">Call Back Patient</span>
            <span class="clc-task-meta">Test results explanation</span>
          </div>
        </div>

        <div class="clc-task-row">
          <span class="clc-task-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
          </span>
          <div class="clc-task-text">
            <span class="clc-task-name">Send Sick Note</span>
            <span class="clc-task-meta">Template ready</span>
          </div>
        </div>

        <div class="clc-task-row">
          <span class="clc-task-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </span>
          <div class="clc-task-text">
            <span class="clc-task-name">Book Follow-up</span>
            <span class="clc-task-meta">2 weeks from today</span>
          </div>
        </div>
      </div>
    </div>

    <!-- AI Clinic Assistant card -->
    <div class="fcard-workflows">
      <div class="clc-head">
        <div class="clc-head-left">
          <span class="clc-icon-box">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1l1.5 4.5L18 7l-4.5 1.5L12 13l-1.5-4.5L6 7l4.5-1.5L12 1z"/><path d="M19 13l.9 2.7L22.5 17l-2.6.8L19 21l-.9-3.2-2.6-.8 2.6-1.3.9-2.7z"/></svg>
          </span>
          <div class="clc-title-block">
            <span class="clc-title accent">AI Clinic Assistant</span>
            <span class="clc-sub">Automated Workflows</span>
          </div>
        </div>
        <span class="clc-tag clc-tag-active">Active</span>
      </div>

      <div class="clc-status-list">
        <div class="clc-status-row">
          <span class="clc-status-icon danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </span>
          <div class="clc-status-body">
            <div class="clc-status-row-top">
              <span class="clc-status-name">Intake Forms</span>
              <span class="clc-status-pill clc-status-pill-detected">Detected</span>
            </div>
            <span class="clc-status-meta">Missing answers detected</span>
          </div>
        </div>

        <div class="clc-status-row">
          <span class="clc-status-icon neutral">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </span>
          <div class="clc-status-body">
            <div class="clc-status-row-top">
              <span class="clc-status-name">Appointment Reminders</span>
              <span class="clc-status-pill clc-status-pill-queued">Queued</span>
            </div>
            <span class="clc-status-meta">SMS queued</span>
          </div>
        </div>

        <div class="clc-status-row">
          <span class="clc-status-icon neutral">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </span>
          <div class="clc-status-body">
            <div class="clc-status-row-top">
              <span class="clc-status-name">Doctor Notes</span>
              <span class="clc-status-pill clc-status-pill-drafted">Drafted</span>
            </div>
            <span class="clc-status-meta">Draft summary created</span>
          </div>
        </div>

        <div class="clc-status-row">
          <span class="clc-status-icon success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6.5"/><path d="M12 22v-6.5"/><polyline points="20 7 12 12 4 7"/><polyline points="20 17 12 22 4 17"/><polyline points="20 12 12 17 4 12"/></svg>
          </span>
          <div class="clc-status-body">
            <div class="clc-status-row-top">
              <span class="clc-status-name">Billing Codes</span>
              <span class="clc-status-pill clc-status-pill-suggested">Suggested</span>
            </div>
            <span class="clc-status-meta">Suggested from visit type</span>
          </div>
        </div>
      </div>

      <a class="clc-review-link" href="#">
        Review Actions
