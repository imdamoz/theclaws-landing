---
import Layout from '../layouts/Layout.astro';
import '../styles/ai-mortgage-admin/styles.css';
import '../styles/ai-mortgage-admin/sections.css';
import '../styles/ai-mortgage-admin/motion.css';
---

<Layout
  title="Mia Project Admin — More projects handed over cleanly. Less time lost to admin."
  description="Connect the project. Mia Project Admin reviews submittals, RFIs and snag lists, and drafts the contractor and consultant chases for whatever is missing."
  ogTitle="Mia Project Admin — More projects handed over cleanly. Less time lost to admin."
  ogDescription="Connect the project. Mia Project Admin reviews submittals, RFIs and snag lists, and drafts the contractor and consultant chases for whatever is missing."
  includeHomeStyles={false}
>

<style is:global>
  /* Mia accent — pink. */
  :root {
    --lime: #FF5CA0;
    --lime-2: #E63A8A;
    --lime-ink: #FFFFFF;
    --lime-rgb: 255, 92, 160;
  }
</style>

<div class="scroll-progress"></div>
<a class="float-cta" href="#book"><span class="dot"></span>Book a call<span class="arrow">→</span></a>

<!-- NAV -->
<header class="wrap">
  <nav class="nav">
    <a class="nav-brand" href="#">
      <img src="/images/the-claws-logo.svg" alt="TheClaws" class="nav-brand-logo" />
      <span>Mia Project Admin</span>
    </a>
    <div class="nav-links">
      <a href="#problem">Problem</a>
      <a href="#how">How it works</a>
      <a href="#case">Case study</a>
      <a href="#incl">Included</a>
      <a href="#faq">FAQ</a>
    </div>
    <a class="btn btn-sm btn-primary" href="#book">Book a call <span class="arrow">→</span></a>
  </nav>
</header>

<!-- ============ HERO (all above fold) ============ -->
<section class="hero wrap">
  <div class="hero-left">
    <div class="eyebrow reveal"><span class="dot"></span>Submittals reviewed in minutes, not hours</div>
    <h1 class="reveal reveal-delay-1">More projects handed over cleanly.<br><span class="mark">Less time lost to admin.</span></h1>
    <p class="sub reveal reveal-delay-2">Connect the project. Mia Project Admin reviews submittals, RFIs and snag lists, and drafts the contractor and consultant chases for whatever is missing.</p>
    <div class="btns reveal reveal-delay-3">
      <a class="btn btn-lime btn-magnet" href="#book">Book a call &amp; see it on your project <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="#how">See how it works</a>
    </div>
    <p class="micro reveal reveal-delay-4">We'll review one live project on the call and show the gaps it would flag — bring the file, no prep needed.</p>

    <hr class="hero-divider reveal reveal-delay-4">

    <div class="hero-caps reveal reveal-delay-5">
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="16" y2="17"></line></svg>
        </span>
        <strong>Reads the whole project</strong>
        <span>Submittals, RFIs, drawings, RAMS, ITPs, programme.</span>
      </div>
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        </span>
        <strong>Drafts the chase</strong>
        <span>Subbies, consultants, client. You review before sending.</span>
      </div>
      <div class="hero-cap">
        <span class="ic">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </span>
        <strong>Fits your firm's process</strong>
        <span>Your QA system, your trade pack, your tone.</span>
      </div>
    </div>
  </div>

  <div class="hero-stage">
    <img class="agent" src="/images/talent-manager.webp" alt="Mia Project Admin reviewing a project file">
    <div class="sbubble"><span class="spark"></span> What needs attention on project #2847?</div>

    <!-- Missing items -->
    <div class="fcard fcard-alert">
      <div class="fc-head">
        <span class="ic">!</span>
        <span>Missing items flagged</span>
        <span class="pill">4</span>
      </div>
      <div class="chip-list">
        <div class="chip-item"><svg class="chip-ic" width="11" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><span><b>RFI 023</b> · architect reply</span></div>
        <div class="chip-item"><svg class="chip-ic" width="11" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><span><b>Submittal</b> · concrete mix</span></div>
        <div class="chip-item"><svg class="chip-ic" width="11" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><span><b>RAMS</b> · MEP subbie</span></div>
        <div class="chip-item"><svg class="chip-ic" width="11" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><span><b>ITR</b> · Block B fire stop</span></div>
      </div>
    </div>

    <!-- Todo -->
    <div class="fcard fcard-todo">
      <div class="fc-head">
        <span class="ic">✓</span>
        <span>Todo List</span>
        <span class="pill lime">2 ITEMS</span>
      </div>
      <div class="todo-i">
        <div class="ti-head">📐 Drawing register<span class="ti-pill">Rev clash</span></div>
        <div class="ti-sub">Issued L02 vs current L03 on plant room</div>
      </div>
      <div class="todo-i">
        <div class="ti-head">📝 Variation log<span class="ti-pill out">Reviewed</span></div>
        <div class="ti-sub">VO-014 added with cost &amp; programme impact</div>
      </div>
    </div>

    <!-- WA -->
    <div class="fcard fcard-wa">
      <div class="fc-head">
        <span class="ic ic-wa" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </span>
        <span>WhatsApp chase</span>
        <span class="pill">Draft</span>
      </div>
      <div class="wa-msg">Hi James, quick one to keep us on programme. Could you send the architect's reply on RFI 023, the concrete mix submittal, and your latest RAMS for the MEP package?</div>
      <div class="wa-meta">
        <span>To: James (MEP)</span>
        <span class="send">Review &amp; send →</span>
      </div>
    </div>
  </div>
</section>

<!-- ========================= CLAIM TICKER ========================= -->
<div class="ticker-band">
  <div class="ticker">
    <span class="t-strong">What would you do with 15 extra hours a week?</span>
    <span class="t-sep">·</span>
    <span>Because that's what the admin is costing you.</span>
    <span class="t-sep">·</span>
    <span class="t-strong">Future PMs don't pay it anymore</span>
    <span class="t-sep">—</span>
    <span>they approve what their AI already packaged.</span>
    <span class="t-sep">·</span>
    <!-- duplicate for seamless loop -->
    <span class="t-strong">What would you do with 15 extra hours a week?</span>
    <span class="t-sep">·</span>
    <span>Because that's what the admin is costing you.</span>
    <span class="t-sep">·</span>
    <span class="t-strong">Future PMs don't pay it anymore</span>
    <span class="t-sep">—</span>
    <span>they approve what their AI already packaged.</span>
    <span class="t-sep">·</span>
  </div>
</div>

<!-- ============ PROBLEM + REAL PROBLEM — combined ============ -->
<section id="problem" class="real bg-grid bg-grid-dark">
  <div class="wrap real-grid">
    <div class="reveal">
      <div class="sec-label">The problem</div>
      <h2>Your project work is not the bottleneck. <em>Project admin</em> is.</h2>
      <p>You already know how to deliver. What slows you down is everything around it: chasing RFI replies, reviewing submittals, tracking variations, evidencing inspections, writing minutes and chasing missing closeout docs.</p>
      <div class="problem-cards">
        <div class="pcard">
          <span class="pcard-k">01 / Doc review</span>
          <h4>Submittals</h4>
          <p>Specs, materials, mix designs, MEP equipment.</p>
        </div>
        <div class="pcard pcard-dark">
          <span class="pcard-k">02 / Risk</span>
          <h4>RFIs &amp; RAMS</h4>
          <p>Open queries, safety, method statements, COSHH.</p>
        </div>
        <div class="pcard">
          <span class="pcard-k">03 / Evidence</span>
          <h4>Inspection records</h4>
          <p>ITPs, ITRs, NCRs, snag lists, sign-offs.</p>
        </div>
        <div class="pcard pcard-lime">
          <span class="pcard-k">04 / Comms work</span>
          <h4>Subbie chase</h4>
          <p>Draft WhatsApps, emails, and follow-up questions.</p>
        </div>
      </div>
    </div>

    <div class="real-col">
      <div class="transcript reveal reveal-delay-2">
        <div class="sec-label">The real problem</div>

        <div class="transcript-stage">
          <img class="transcript-photo" src="/images/the-real-problem.png" alt="An exhausted project manager at a desk surrounded by drawings and paperwork" />

          <div class="stage-overlay">
            <div class="stage-quote-wrap">
              <blockquote class="stage-quote">
                I feel like I'm working at <span class="hl">full capacity</span>, but I can't grow because admin eats my time.
              </blockquote>
              <div class="sig stage-sig">— PM using Mia Project Admin</div>
            </div>

            <div class="notes-wall" aria-hidden="true">
              <div class="note note-1">
                <span class="note-tape"></span>
                <p>"Submittal returned. Wrong revision. Same as last week."</p>
                <span class="note-attr">— PM, Birmingham</span>
              </div>
              <div class="note note-2 note-lime">
                <span class="note-tape"></span>
                <p>"Closeout pack is 14 trades. Miss one, retention's gone."</p>
                <span class="note-attr">— Site manager, Bristol</span>
              </div>
              <div class="note note-3">
                <span class="note-tape"></span>
                <p>"Site dailies at 11pm. My family sees me less than my Procore."</p>
                <span class="note-attr">— Director, Manchester</span>
              </div>
            </div>
          </div>
        </div>

        <div class="body-txt">
          The admin around each project sets the cap. <strong>More projects means more submittals to review</strong>, more RFIs to chase, more subbies to track, more closeout packs to compile. So the PM either stops taking on more projects, or takes them and pays for it with evenings and weekends.
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FIXES — problems + how it fits ============ -->
<section class="fixes">
  <div class="wrap">
    <div class="fixes-head reveal">
      <div class="sec-label fixes-eyebrow">
        <svg class="sl-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Why the usual fixes do not work
      </div>
      <h2>Hiring a document controller takes months. Templates <em>do not read the drawings</em>. Generic AI does not know an RFI from an NCR.</h2>
    </div>

    <div class="fix-row reveal reveal-delay-2">
      <div class="fix-card fc-fail">
        <span class="fc-badge fc-x" aria-hidden="true">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </span>
        <span class="fc-ic" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
        <h4>A document controller</h4>
        <p>Costs a full salary before it helps. Needs training on your firm's process, your trade pack and your quality manual. Still leaves the PM doing the judgement calls.</p>
      </div>
      <div class="fix-card fc-fail">
        <span class="fc-badge fc-x" aria-hidden="true">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </span>
        <span class="fc-ic" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </span>
        <h4>Email and PM tool templates</h4>
        <p>Generic "please reply by Friday" messages. They do not look at the drawings, do not know what is actually missing, and the subbie ignores them or sends the wrong revision.</p>
      </div>
      <div class="fix-card fc-fail">
        <span class="fc-badge fc-x" aria-hidden="true">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </span>
        <span class="fc-ic" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        </span>
        <h4>Generic AI chatbots</h4>
        <p>Wait for you to explain the whole project from scratch every time. They do not understand RFI cycles, submittal review, NCRs, retention or why a delayed substructure pour needs a programme update.</p>
      </div>
    </div>

    <div class="fits-box reveal reveal-delay-3">
      <span class="fits-pill">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        How it fits
      </span>
      <div class="fits-body">
        <h3>A review and drafting layer. You stay the PM on the project.</h3>
        <div class="fits-body-copy">
          <p>Every flag, every WhatsApp, every email is reviewed by you before anything moves. Mia Project Admin does not send, sign or submit anything off.</p>
        </div>
      </div>

      <div class="fix-row fix-row-win">
        <div class="fix-card fc-win">
          <span class="fc-badge fc-check" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="fc-ic" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><polyline points="9 12 11 14 15 10"/></svg>
          </span>
          <h4>You decide what goes out</h4>
          <p>It drafts, flags, and asks. It does not send, submit, or sign anything off.</p>
        </div>
        <div class="fix-card fc-win">
          <span class="fc-badge fc-check" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="fc-ic" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </span>
          <h4>Built for construction projects</h4>
          <p>RFIs, submittals, RAMS, ITPs, NCRs, variations, closeout packs. Not generic document review.</p>
        </div>
        <div class="fix-card fc-win">
          <span class="fc-badge fc-check" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="fc-ic" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
          </span>
          <h4>Fits your firm's process</h4>
          <p>Your QA system, your trade pack, your approved tone. Configured at setup.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ HOW — step flow ============ -->
<section id="how" class="how bg-grid">
  <div class="wrap">
    <div class="sec-label reveal">How it works</div>
    <h2 class="reveal reveal-delay-1">Four steps from messy file to <em>handover-ready.</em></h2>

    <div class="how-flow">
      <div class="hstep reveal reveal-delay-2">
        <span class="hs-eyebrow">Step one</span>
        <h3>Upload the project documents</h3>
        <div class="hs-visual">
          <div class="doc-mock">
            <span class="doc-line w70"></span>
            <span class="doc-line w50"></span>
            <span class="doc-line w65"></span>
            <span class="doc-block"></span>
          </div>
        </div>
        <p>Drawings, submittals, RFIs, RAMS, ITPs, programme, variations, minutes.</p>
        <span class="hs-tag">Drop the file</span>
      </div>

      <div class="hs-arrow" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </div>

      <div class="hstep reveal reveal-delay-3">
        <span class="hs-eyebrow">Step two</span>
        <h3>Mia Project Admin reviews the project</h3>
        <div class="hs-visual">
          <div class="review-mock">
            <div class="rm-card-back"></div>
            <div class="rm-card">
              <span class="rm-head"></span>
              <span class="rm-line w60"></span>
              <span class="rm-line w45"></span>
              <span class="rm-reply" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 10 20 15 15 20"/><path d="M4 4v7a4 4 0 0 0 4 4h12"/></svg>
              </span>
            </div>
          </div>
        </div>
        <p>Checks every document, cross-references the story, flags what is missing or risky.</p>
        <span class="hs-tag">Full review</span>
      </div>

      <div class="hs-arrow" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </div>

      <div class="hstep reveal reveal-delay-4">
        <span class="hs-eyebrow">Step three</span>
        <h3>You get flags, questions &amp; drafts</h3>
        <div class="hs-visual">
          <div class="chips-mock">
            <span class="cm-chip cm-1">Late RFI</span>
            <span class="cm-chip cm-2">Missing RAMS</span>
            <span class="cm-chip cm-3">Variation gap</span>
          </div>
        </div>
        <p>Review the gaps, approve the WhatsApp or email chase, decide what goes to the trade.</p>
        <span class="hs-tag">Clear gaps</span>
      </div>

      <div class="hs-arrow" aria-hidden="true">
