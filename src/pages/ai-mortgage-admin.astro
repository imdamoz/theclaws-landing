    </div>

    <!-- Todo -->
    <div class="fcard fcard-todo">
      <div class="fc-head">
        <span class="ic">✓</span>
        <span>Todo List</span>
        <span class="pill lime">2 ITEMS</span>
      </div>
      <div class="todo-i">
        <div class="ti-head">🗂 Credit File<span class="ti-pill">Undisclosed</span></div>
