---
const {
  title = 'TheClaws — AI Super Agents',
  description = 'AI Super Agents that maximize human productivity',
  ogTitle = 'TheClaws — Scale your business without hiring more staff',
  ogDescription = 'Deploy AI Agents in minutes to handle follow-ups, booking, project coordination, and invoicing inside your existing tools.',
  ogImage = 'https://theclaws.ai/assets/featured-img.png',
  ogUrl = 'https://theclaws.ai',
  includeHomeStyles = true,
} = Astro.props;

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/images/theclaws-favicon.png" type="image/png" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:site_name" content="TheClaws" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Hotjar Tracking Code -->
  <script is:inline>
    (function(h,o,t,j,a,r){
        h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
        h._hjSettings={hjid:6687129,hjsv:6};
        a=o.getElementsByTagName('head')[0];
        r=o.createElement('script');r.async=1;
        r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
        a.appendChild(r);
    })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
  </script>

  <!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1398538578060948');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1398538578060948&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap" rel="stylesheet">
  <style is:global>
    @font-face {
      font-family: 'Plus Jakarta Sans';
      src: url('/fonts/PlusJakartaSans-VariableFont_wght.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    @font-face {
      font-family: 'Inter';
      src: url('/fonts/Inter.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    @font-face {
      font-family: 'Sometype Mono';
      src: url('/fonts/SometypeMono-VariableFont.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    .AgentCarousel_greenGhost___BVRS { opacity: 1 !important; }
    .AgentCarousel_mysteryMask__a9GUR { opacity: 1 !important; }
    .ExpandablePill_expandablePill__Cmoj5 { opacity: 1 !important; }
  </style>

  {includeHomeStyles && (
    <>
      <!-- Homepage Webflow + TheClaws reference CSS bundle -->
      <link rel="stylesheet" href="/inspiration3/css/sintraweb.shared.61297f412.min.css" />
      <link rel="stylesheet" href="/css/f940fe1fd2e7ae7a.css" />
      <link rel="stylesheet" href="/css/ef46db3751d8e999.css" />
      <link rel="stylesheet" href="/css/adaeedc4bf7ccafc.css" />
      <link rel="stylesheet" href="/css/3620510e7c1dbba6.css" />
      <link rel="stylesheet" href="/css/56c650500295bc46.css" />
      <link rel="stylesheet" href="/css/3d7024d4ab600e69.css" />
    </>
  )}

  <slot name="head" />
</head>
<body>
<slot />

{import.meta.env.DEV && (
  <>
  <style is:global>
    .nav-pages-dd { position: relative; }
    .nav-pages-dd-btn {
      background: transparent;
      border: 1px dashed #BEC9C2;
      border-radius: 999px;
      padding: 6px 12px;
      font: inherit;
      font-size: 13px;
      color: #71717A;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }
    .nav-pages-dd-btn::before {
      content: 'DEV';
      background: #F43F5E;
      color: #fff;
      font-size: 8px;
      font-weight: 800;
      letter-spacing: 0.08em;
      padding: 2px 5px;
      border-radius: 3px;
    }
    .nav-pages-dd-btn::after { content: '▾'; font-size: 10px; }
    .nav-pages-dd-btn:hover { color: #18181B; border-color: #18181B; }
    .nav-pages-dd-menu {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      min-width: 220px;
      background: #FFFFFF;
      border-radius: 14px;
      box-shadow: 0 16px 40px rgba(0,0,0,0.18), 0 0 0 1px rgba(0,0,0,0.05);
      padding: 6px;
      display: none;
      z-index: 100;
    }
    .nav-pages-dd.open .nav-pages-dd-menu { display: block; }
    .nav-pages-dd-menu a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 9px 12px;
      border-radius: 8px;
      font-size: 13px;
      color: #18181B;
      text-decoration: none;
      font-weight: 500;
    }
    .nav-pages-dd-menu a small { color: #71717A; font-size: 11px; font-weight: 500; }
    .nav-pages-dd-menu a:hover { background: #F4F4F5; }
    .nav-pages-dd-menu a.active { background: #18181B; color: #fff; }
    .nav-pages-dd-menu a.active small { color: rgba(255,255,255,0.7); }
  </style>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const navLinks = document.querySelector('.nav-links')
        || document.querySelector('[class*="navLinks"]');
      if (!navLinks) return;
      const here = location.pathname.replace(/\/$/, '') || '/';
      const pages = [
        ['/',                       'Home',        ''],
        ['/ai-mortgage-admin',      'Mortgage',    'Kai'],
        ['/ai-real-estate-admin',   'Real Estate', 'Max'],
        ['/ai-construction-admin',  'Construction','Mia'],
        ['/ai-clinic-admin',        'Clinic',      'Mia'],
        ['/ai-events-admin',        'Events',      'Eve'],
        ['/ai-church-admin',        'Church',      'Zara'],
      ];
      const dd = document.createElement('div');
      dd.className = 'nav-pages-dd';
      dd.innerHTML = '<button type="button" class="nav-pages-dd-btn">Pages</button>' +
        '<div class="nav-pages-dd-menu">' +
        pages.map(([href, label, agent]) => {
          const active = (here === href) ? ' active' : '';
          const url = href === '/' ? '/' : href + '/';
          const right = agent ? '<small>' + agent + '</small>' : '';
          return '<a href="' + url + '" class="' + active.trim() + '"><span>' + label + '</span>' + right + '</a>';
        }).join('') +
        '</div>';
      navLinks.appendChild(dd);
      const btn = dd.querySelector('.nav-pages-dd-btn');
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        dd.classList.toggle('open');
      });
      document.addEventListener('click', () => dd.classList.remove('open'));
    });
  </script>
  </>
)}

<!-- Intercom -->
<script is:inline>
  window.intercomSettings = {
    api_base: "https://api-iam.intercom.io",
    app_id: "e29gg36k",
  };
</script>
<script is:inline>
  (function(){var w=window;var ic=w.Intercom;if(typeof ic==="function"){ic('reattach_activator');ic('update',w.intercomSettings);}else{var d=document;var i=function(){i.c(arguments);};i.q=[];i.c=function(args){i.q.push(args);};w.Intercom=i;var l=function(){var s=d.createElement('script');s.type='text/javascript';s.async=true;s.src='https://widget.intercom.io/widget/e29gg36k';var x=d.getElementsByTagName('script')[0];x.parentNode.insertBefore(s,x);};if(document.readyState==='complete'){l();}else if(w.attachEvent){w.attachEvent('onload',l);}else{w.addEventListener('load',l,false);}}})();
</script>
</body>
</html>
